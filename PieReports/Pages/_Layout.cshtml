                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        @foreach (var menu in Model.menus)
                        {

                        <li class="nav-item" id="Dparent1">
                            @if (menu.parent_id == "0" && menu.name != "User Manual")
                            {
                                @if (menu.source_path == null || menu.source_path == "")
                                {
                                    <a href="@menu.source_path" class="nav-link active" id="parent_broacha1">
                                            <img src="~/images/NavMenu/@menu.Icon_path" alt="logo.png" class="img-responsive6" style="width:25px;">
                                        <p name="@menu.name" id="@menu.id" style="font-size:16px;">@menu.name</p>
                                        <i class="right fas fa-angle-down"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="@menu.source_path" class="nav-link active" id="parent_broacha1">
                                        <img src="~/images/NavMenu/@menu.Icon_path" alt="logo.png" class="img-responsive6" style="width:25px;">
                                        <p name="@menu.name" id="@menu.id" style="font-size:16px;">@menu.name</p>
                                    </a>
                                }

                            }
                            @foreach (var submenu in Model.menus.FindAll(x => x.parent_id.Equals(menu.id)))
                            {

                                <ul class="nav nav-treeview" style="margin-left:7px;">
                                    <li class="nav-item" id="Dparent2">
                                        @if(submenu.target == "1")
                                        {
                                            <a href="@submenu.source_path" class="nav-link" id="parent_broacha3" target="_blank">
                                                @*<i class="far fa-circle nav-icon"></i>*@
                                                <p class="findId" name="@submenu.name" id="@submenu.id" style="font-size:14px;">@submenu.name</p>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@submenu.source_path" class="nav-link" id="parent_broacha3">
                                                @*<i class="far fa-circle nav-icon"></i>*@
                                                <p class="findId" name="@submenu.name" id="@submenu.id" style="font-size:14px;">@submenu.name</p>
                                                    @if (submenu.source_path == null || submenu.source_path == "")
                                                    {
                                                        <i class="right fas fa-angle-down"></i>
                                                    }
                                            </a>
                                        }


                                        @foreach (var submenu1 in Model.menus.FindAll(x => x.parent_id.Equals(submenu.id)))
                                        {
                                            //if (submenu1.id == "142" || submenu1.id == "23" || submenu1.id == "41" || submenu1.id == "167" || submenu1.id == "139" || submenu1.id == "168" || submenu1.id == "109" || submenu1.id == "174")
