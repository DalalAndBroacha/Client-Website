@model ViewModel.Login.Dashboard
@using ViewModel.Login;

@*  ===========================================================================
    Post-login application shell (header + sidebar + shared dialogs).

    This file used to emit a complete second HTML document — <!DOCTYPE>,
    <html>, <head>, <body> — *inside* the <body> of Views/Shared/_Layout.cshtml.
    That nesting is a WCAG 4.1.1 Parsing failure, and it silently discarded the
    nested <title> and <meta viewport>, so every post-login page inherited the
    outer generic title (2.4.2) and the outer zoom-blocking viewport (1.4.4).

    It is now a fragment. The document-level concerns live in
    Views/Shared/_Layout.cshtml, and the AdminLTE body classes are handed up
    to it through HttpContext.Items (see below).
    =========================================================================== *@

@{
    // Html.RenderPartial(name, model) hands a partial a *copy* of ViewData, so
    // writing ViewData here never reaches the layout. HttpContext.Items is
    // shared for the whole request and is read by Views/Shared/_Layout.cshtml
    // when it renders <body>, which happens after this partial has run.
    Context.Items["BodyClass"] = "hold-transition sidebar-mini layout-fixed layout-navbar-fixed layout-footer-fixed";
}

