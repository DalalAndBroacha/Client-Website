<div class="wrapper">
    @* WCAG 1.3.1 Info and Relationships — the page banner is a <header>
       landmark. The two <nav> elements on the page each carry a distinct
       aria-label so they can be told apart (2.4.5). *@
    <header class="main-header navbar navbar-expand navbar-dark navpanel pd-bottom40">
        <!-- Left navbar links -->
        <ul class="navbar-nav" id="main_UL">
            <li class="nav-item">
                @* 4.1.2 Name, Role, Value — an icon-only control needs a name
                   and, as a disclosure, an aria-expanded that JS keeps in
                   sync (see accessibility.js). *@
                <button class="nav-link btn btn-link" type="button" data-widget="pushmenu"
                        aria-label="Toggle navigation menu" aria-expanded="true" aria-controls="main-sidebar-nav">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
            </li>
            <li class="nav-item mb-mleft5" style="margin-left: 10px;">
                @* 1.1.1 — decorative icon beside a labelled control. *@
                <img id="img_ddlFinyear" src="~/New Icons/Calander.svg" alt="" class="img-responsive5" style="width:35px;" />
            </li>
            <li class="nav-item mb-mleft10" style="margin-left: 7px;">
                @* 3.3.2 Labels or Instructions — persistent, programmatically
                   associated label. Visually hidden because the calendar icon
                   beside it carries the meaning for sighted users. *@
                <label for="ddlFinyear" class="a11y-visually-hidden">Financial year</label>
                <select id="ddlFinyear" class="form-control select2">
                    @if (Model.dashboardFinYears != null)
                    {
                        @foreach (var key in Model.dashboardFinYears)
                        {
                            <option value="@key.ID">@key.year</option>
                        }
                    }
                </select>
            </li>
            <li class="nav-item mb-mleft10" style="margin-left: 10px;">
                <img id="img_ddlFamilyList" src="~/New Icons/FamIcon.png" alt="" class="img-responsive5" style="width:35px;" />
            </li>
            <li class="nav-item mb-mleft10" style="margin-left: 7px;">
                <label for="ddlFamilyList" class="a11y-visually-hidden">Family</label>
                <select class="form-control select2" id="ddlFamilyList">
                    @if (Model.familyLists != null)
                    {
                        @if (Model.familyLists.Count < 501)
                        {
                            @foreach (var key in Model.familyLists)
                            {
                                <option value="@key.Family_Token">@key.Family_Name</option>
                            }

                        }
                        else
                        {
                            @foreach (var key in Model.familyLists.Take(501))
                            {
                                <option value="@key.Family_Token">@key.Family_Name</option>
                            }
                        }
                    }
                </select>
                <input type="text" id="preservedFamToken" hidden>
                <input type="text" id="preservedFamText" hidden>
            </li>
        </ul>
        <!-- Right navbar links -->
        <ul class="navbar-nav ml-auto right_sidebar">

            @*<li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#" aria-expanded="false" role="button">
                        <span><i class="fas fa-star fa-2x White_Red_Icon" title="Favourites" aria-hidden="true"></i></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="left: inherit; right: 0px;">
                        <div id="divFetchfev"></div>
                    </div>
                </li>*@
            <li class="nav-item">
                @* 2.4.4 Link Purpose — the accessible name comes from the
                   aria-label, not from a `title` on a decorative glyph. *@
                <a class="nav-link" href="/ClientPortal/Pie/Contact_Us" aria-label="Contact us">
                    <span>
                        <i class="fas fa-phone-square-alt fa-2x White_Red_Icon" aria-hidden="true"></i>
                    </span>
                </a>
            </li>
            <li class="nav-item">
                @* This opens a PDF in an in-page dialog, so it is a button,
                   not a link (2.1.1, 4.1.2). *@
                <button type="button" class="nav-link btn btn-link" data-toggle="modal" data-target="#myModalLayout"
                        aria-label="Open the client portal user manual"
                        onclick="ReportIFrameLayout('https://dalal-broacha.com/pdfs/Client%20Portal%20User%20Manual.pdf','User Manual');">
                    <span><i class="fas fa-info-circle fa-2x White_Red_Icon" aria-hidden="true"></i></span>
                </button>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/ClientPortal/Pie/Download_Reports" aria-label="Go to downloads">
                    <span><i class="fas fa-cloud-download-alt fa-2x White_Red_Icon" aria-hidden="true"></i></span>
                </a>
            </li>

            <li class="nav-item dropdown">
                <button type="button" class="nav-link btn btn-link" data-toggle="dropdown"
                        aria-expanded="false" aria-haspopup="true" aria-label="User details">
                    <span><i class="fas fa-user fa-2x White_Red_Icon" aria-hidden="true"></i></span>
                </button>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="left: inherit; right: 0px;">
                    <div class="form-group-dashboard">

                        @* 4.1.1 Parsing — <input> is not permitted inside <p>
                           in a way that keeps the reading order sane; the
                           hidden state fields now sit alongside the text. *@
                        <p class="dropdown-item" style="background-color:#ffb3b3;font-size:12px;">
                            Logged in as:<br /><span style="background-color:#ffb3b3;font-size:14px;">  @Model.Login_client_name </span>
                        </p>
                        <input type="hidden" id="LoggedInUID" value="@Model.Id" />
                        <input type="hidden" id="LoggedInUserHash" value="@Model.row_guid" />
                        <input type="hidden" id="LoggedInRoleName" value="@Model.Role_Name" />
                        <input type="hidden" id="Curr_Fam_ID" />
                    </div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="/ClientPortal/Pie/Profile_Update" style="font-family: inherit; font-size: 15px;">
                        Update Profile
                    </a>
                    <div class="dropdown-divider"></div>
                    @*<div class="form-group-dashboard">
                            <p name="trading" data-toggle="modal" data-target="#ChangeUsernameM" class="dropdown-item">
                                <a href="#" onclick="ChangeUsernameDashboardModel()" style="font-family: inherit; font-size: 15px;" role="button">
                                    Change Username
                                </a>
                            </p>
                        </div>
                        <div class="dropdown-divider"></div>*@
                    @*<div class="form-group-dashboard">
                            <p name="trading" class="dropdown-item">
                                <input type="checkbox" value="1" checked="checked" style="margin-left: 15px;"><span style="padding:10px;">Dark Mode</span>
                            </p>
                        </div>*@
                </div>
            </li>

            <li class="nav-item" style="margin-left: 20px;">
                <p class="mb-mtop0 textweight" style="margin-top:10px;color: #000;"> @Model.Login_client_name </p>
            </li>
            <li class="nav-item mb-mtop0" style="margin-left: 20px;margin-top: 7px;">
                @* Signing out is a state change, so it is a POST from a real
                   submit button rather than a link (2.1.1, 4.1.2). The form
                   no longer wraps a bare <a>, which was neither submitting
                   the form nor announcing itself as a link with a purpose. *@
                <form method="post" action="@Url.Action("LogOut", "Login")" class="d-inline">
                    <button type="submit" class="btn btn-link nav-link p-0" aria-label="Sign out">
                        <span><i class="fas fa-power-off fa-2x White_Red_Icon" aria-hidden="true"
                                 style="border-radius:5px; padding:2px;"></i></span>
                    </button>
                </form>
            </li>

        </ul>
    </header>
    <!-- /.navbar -->
    <!-- Main Sidebar Container -->
    <aside class="main-sidebar elevation-4 sidebar-dark-primary">
        <!-- Brand Logo -->
        @* 1.1.1 Non-text Content — functional image: the alt describes the
           destination, not the picture. *@
        <a href="/ClientPortal/Pie/PieReport" class="brand-link">
            <img src="~/images/logo.svg" alt="Dalal &amp; Broacha client portal home">
        </a>

        <!-- Sidebar -->
        <div class="sidebar">

            @* 2.4.5 Multiple Ways — a set of pages must offer more than one
               way to reach a page. The portal had only the navigation menu;
               this is the second way: a search over the same menu, wired up in
               js/accessibility.js. It reports its result count through a live
               region so the outcome is announced without moving focus (4.1.3). *@
            <div class="p-2" role="search">
                <label for="a11y-nav-search" class="a11y-visually-hidden">Search the menu</label>
                <input type="search" id="a11y-nav-search" class="form-control form-control-sm"
                       placeholder="Search the menu" autocomplete="off"
                       aria-describedby="a11y-nav-search-hint">
                <p id="a11y-nav-search-hint" class="a11y-visually-hidden">
                    Type to filter the navigation menu below. Results update as you type.
                </p>
                <p id="a11y-nav-search-status" role="status" aria-live="polite" class="a11y-visually-hidden"></p>
            </div>

            @* 2.4.5 Multiple Ways / 1.3.1 — the primary navigation landmark.
               role="menu" was removed: it promises the ARIA menu keyboard
               model (arrow keys, menuitem children) that this list of links
               does not implement, which is a 4.1.2 failure. A plain nav of
               links is correct and needs no role. *@
            <nav class="mt-2" id="main-sidebar-nav" aria-label="Main">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" data-accordion="false">
                    @foreach (var menu in Model.menus)
                    {

                    <li class="nav-item">
                        @if (menu.parent_id == "0" && menu.name != "User Manual")
                        {
                            @if (menu.source_path == null || menu.source_path == "")
                            {
                                @* No destination: this entry only expands its
                                   submenu, so it is a button (2.1.1). *@
                                <a href="#" role="button" class="nav-link active">
                                    <img src="~/images/NavMenu/@menu.Icon_path" alt="" class="img-responsive6" style="width:25px;">
                                    <p name="@menu.name" id="@menu.id" style="font-size:16px;">@menu.name</p>
                                    <i class="right fas fa-angle-down" aria-hidden="true"></i>
                                </a>
                            }
                            else
                            {
                                <a href="@menu.source_path" class="nav-link active">
                                    <img src="~/images/NavMenu/@menu.Icon_path" alt="" class="img-responsive6" style="width:25px;">
                                    <p name="@menu.name" id="@menu.id" style="font-size:16px;">@menu.name</p>
                                </a>
                            }

                        }
                        @foreach (var submenu in Model.menus.FindAll(x => x.parent_id.Equals(menu.id)))
                        {

                            <ul class="nav nav-treeview" style="margin-left:7px;">
                                <li class="nav-item">
                                    @if(submenu.target == "1")
                                    {
                                        @* 2.4.4 — warn that the link leaves
                                           the portal in a new tab. *@
                                        <a href="@submenu.source_path" class="nav-link" target="_blank" rel="noopener noreferrer">
                                            <p class="findId" name="@submenu.name" id="@submenu.id" style="font-size:14px;">
                                                @submenu.name<span class="a11y-visually-hidden"> (opens in a new tab)</span>
                                            </p>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@submenu.source_path" class="nav-link">
                                            <p class="findId" name="@submenu.name" id="@submenu.id" style="font-size:14px;">@submenu.name</p>
                                                @if (submenu.source_path == null || submenu.source_path == "")
                                                {
                                                    <i class="right fas fa-angle-down" aria-hidden="true"></i>
                                                }
                                        </a>
                                    }


                                    @foreach (var submenu1 in Model.menus.FindAll(x => x.parent_id.Equals(submenu.id)))
                                    {
                                        <ul class="nav nav-treeview mb-mleft0" style="margin-left:15px;">
                                            <li class="nav-item">
                                                <a href="@submenu1.source_path" class="nav-link">

                                                    <p class="findId" name="@submenu1.name" id="@submenu1.id" style="font-size:12px;">@submenu1.name</p>
                                                        @if (submenu1.source_path == null || submenu1.source_path == "")
                                                        {
                                                            <i class="right fas fa-angle-down" aria-hidden="true"></i>
                                                        }
                                                </a>
                                            </li>
                                        </ul>

                                    }
                                </li>
                            </ul>
                        }
                    </li>



                    }
                </ul>

            </nav>

            <!-- /.sidebar-menu -->
        </div>
        <!-- /.sidebar -->
    </aside>

    @* 4.1.2 Name, Role, Value — a dialog needs role, the modal flag and an
       accessible name. 2.1.2 / 2.4.3 — Bootstrap handles Esc, the focus trap
       and focus restore; accessibility.js moves focus in on open. *@
    <div class="modal fade" id="myModalLayout" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="myModalLayout-title">
        <div class="modal-dialog modal-lg modal-dialog-centered" style="min-width:100%;">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h2 class="modal-title h6" id="myModalLayout-title" style="padding:10px;"></h2>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close dialog">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="padding: 0rem !important;">
                    @* 4.1.2 / 2.4.1 — every iframe needs a title so screen
                       reader users know what is inside before entering it. *@
                    <iframe src="" title="Document viewer" style="width: 100% !important;height:600px" frameborder="0" allowtransparency="true"></iframe>
                </div>

            </div>
        </div>
    </div>

