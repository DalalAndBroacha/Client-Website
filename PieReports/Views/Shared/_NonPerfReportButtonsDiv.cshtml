@* 4.1.1 Parsing — some reports render this partial once per section, so every
   id goes through A11yIds.Unique (Utility/A11yIds.cs): the first copy keeps
   the plain id, later copies get -2, -3. *@
@{
    var ButtonsDivId = "buttons_div_" + @ViewBag.ReportHeaderDiv;
}
<nav class="navbar navbar-expand mb-mt SubTotalRow" id="@A11yIds.Unique(Context, ButtonsDivId)">
    <div style="width:100%" class="d-flex justify-content-end">
        @if (ViewBag.PrimaryReport != "True")
        {
            <button title="Back to previous Report" id="@A11yIds.Unique(Context, (string)ViewBag.ElementBackBtnID)" aria-label="Back to previous report" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="fas fa-arrow-left" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
        }
        @*
        <button title="Print This Page" id="@A11yIds.Unique(Context, (string)ViewBag.ElementPrintBtnID)" onclick=@ViewBag.ElementPrintBtnOnClickEvent aria-label="Print this page" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
            <i class="fas fa-print" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
        </button>*@
        @if (ViewBag.ElementEmailBtnID != null)
        {
            @if (ViewBag.EmailBackdropID != null)
            {
                <button title="Email" id="@A11yIds.Unique(Context, (string)ViewBag.ElementEmailBtnID)" data-toggle="modal" data-target="@ViewBag.EmailBackdropID" aria-label="Email" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            else
            {
                <button title="Email" id="@A11yIds.Unique(Context, (string)ViewBag.ElementEmailBtnID)" aria-label="Email" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
        }
        @if (ViewBag.ElementExcelBtnID != null)
        {
            @if (ViewBag.ExcelBackdropID != null)
            {
                <button title="Export to Excel" id="@A11yIds.Unique(Context, (string)ViewBag.ElementExcelBtnID)" data-toggle="modal" data-target="@ViewBag.ExcelBackdropID" aria-label="Export to Excel" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            else
            {
                <button title="Export to Excel" id="@A11yIds.Unique(Context, (string)ViewBag.ElementExcelBtnID)" aria-label="Export to Excel" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
        }
        @if (ViewBag.ElementPDFBtnID != null)
        {

            @if (ViewBag.PdfBackdropID != null)
            {
                <button title="Export to PDF" id="@A11yIds.Unique(Context, (string)ViewBag.ElementPDFBtnID)" data-toggle="modal" data-target="@ViewBag.PdfBackdropID" aria-label="Export to PDF" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            else
            {
                <button title="Export to PDF" id="@A11yIds.Unique(Context, (string)ViewBag.ElementPDFBtnID)" aria-label="Export to PDF" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
        }
        @*@if (ViewBag.PrimaryReport == "True")
        {
            <button title="Add to favourite" onclick="PerformanceUpdateFev()" id="@A11yIds.Unique(Context, "PerformanceAddtoFavourite")" aria-label="Add to favourite" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="far fa-star" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
            <button title="Remove from favourite" onclick="PerformanceDeleteFev()" id="@A11yIds.Unique(Context, "PerformanceRemoveFavourite")" aria-label="Remove from favourite" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <span class="strikethrough_icon"><i class="far fa-star" aria-hidden="true" style="color: white; padding:0; width:30px;"></i></span>
            </button>
        }*@

    </div>
</nav>
