@{
    var headerId = "header_div_" + @ViewBag.ReportHeaderDiv;
    var report_date = "report_date_" + @ViewBag.ReportHeaderDiv;
}

<div class="SubTotalRow row" id=@headerId>
    <div class="offset-2"></div>
    <div class="col-8 d-flex justify-content-center">
        <p style="text-align:center">
            <b id="lblReport_Name">@ViewBag.ReportName</b>
            @if (ViewBag.GenDate == "True")
            {
                if (ViewBag.GenPeriod == "True")
                {
                    <b><b id="report_start_date"></b> to <b id="report_end_date"></b></b>
                    <br />
                }
                else
                {
                    <b id="@report_date">@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b>
                    <br />
                }
            }
            <br />
            <span style="font-size:9px;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span>
        </p>
    </div>
    <div class="col-2">
        <div class="row justify-content-center mt-2">
            @if (ViewBag.PrimaryReport != "True")
            {
                <button title="Back to previous Report" id=@ViewBag.ElementBackBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="fas fa-arrow-left" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            <a class="nav-link dropdown-toggle" href="#" role="button" 
            data-toggle="dropdown" aria-expanded="false" 
            style="border:1px solid; border-radius:10px; width:fit-content; height:fit-content;">
                Export
            </a>
            <div class="dropdown-menu">
                <a class="dropdown-item" href="#"><i class="far fa-file-pdf" style="color: darkred; padding:0;"></i>Export to PDF</a>
                <a class="dropdown-item" href="#"><i class="far fa-file-excel" style="color: green; padding:0;"></i>Export to Excel</a>
                <a class="dropdown-item" href="#"><i class="fas fa-envelope" style="color: dodgerblue; padding:0;"></i>Email</a>
                <a class="dropdown-item" href="#"><i class="fab fa-whatsapp" style="color: forestgreen; padding:0;"></i>Whatsapp</a>
            </div>
           @*  <div>
                <div>
                    <i class="far fa-file-pdf"></i>Export to PDF
                </div>
                <div>
                    <i class="far fa-file-excel"></i>Export to Excel
                </div>
                <div>
                    <i class="fas fa-envelope"></i>Email
                </div>
                <div>
                    <span><i class="fab fa-whatsapp" style="color: white; padding:0; width:30px;"></i></span>Whatsapp
                </div>

            </div> *@
            @*
            <button title="Print This Page" id=@ViewBag.ElementPrintBtnID onclick=@ViewBag.ElementPrintBtnOnClickEvent style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
            <i class="fas fa-print" style="color: white; padding:0; width:30px;"></i>
            </button>*@

           @*  <i class="fab fa-whatsapp-square" style="color: white; padding:0; width:30px;"></i>

            <i class="fab fa-whatsapp"></i>

            <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID data-toggle="modal" data-target="@ViewBag.PdfBackdropID" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="fab fa-whatsapp" style="color: white; padding:0; width:30px;"></i>
            </button>

            @if (ViewBag.ElementPDFBtnID != null)
            {

                @if (ViewBag.PdfBackdropID != null)
                {
                    <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID data-toggle="modal" data-target="@ViewBag.PdfBackdropID" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="far fa-file-pdf" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="far fa-file-pdf" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            }
            @if (ViewBag.ElementExcelBtnID != null)
            {
                @if (ViewBag.ExcelBackdropID != null)
                {
                    <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID data-toggle="modal" data-target="@ViewBag.ExcelBackdropID" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="far fa-file-excel" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="far fa-file-excel" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            }

            @if (ViewBag.ElementEmailBtnID != null)
            {
                @if (ViewBag.EmailBackdropID != null)
                {
                    <button title="Email" id=@ViewBag.ElementEmailBtnID data-toggle="modal" data-target="@ViewBag.EmailBackdropID" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="fas fa-envelope" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Email" id=@ViewBag.ElementEmailBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                        <i class="fas fa-envelope" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            } *@
        </div>
    </div>
</div>


