@model ViewModel.Login.otp


<div class="row">
    <div class="col-sm-12">
        <div class="md-float-material form-material">

            <div class="auth-box card">
                <div class="card-block">
                    <div class="row m-b-20">
                        <div class="col-md-12">
                            <div class="text-center" id="divRedireLogin">
                                @* 1.1.1 Non-text Content — functional image: the alt
                                   describes where the link goes, not the artwork. *@
                                <a href="@Url.Action("Index","Login")"><img src="~/images/logo.svg" alt="Dalal &amp; Broacha client portal home"></a>
                            </div>
                        </div>
                    </div><br />
                    <form class="col-12 col-lg-12 col-xl-12 mx-auto" id="formUpdateVettingParties">
                        @* 2.4.6 Headings and Labels — when this partial renders, it
                           replaces the whole page body, so it must supply the h1. *@
                        <h1 class="h5 text-center">Enter your one-time code</h1>

                        @* 4.1.3 Status Messages — announced without moving focus. *@
                        <p class="text-muted mb-4" role="status" aria-live="polite">@Model.sql_message</p>

                        @* 3.3.1 Error Identification — the verification error is
                           announced as soon as the script writes it. *@
                        <span style="font-variant-caps: all-petite-caps; color: #b3241a;" id="myform" role="alert" aria-live="assertive"></span>
                        @*@using (Html.BeginForm("otpVerify", "Login", FormMethod.Post))
            {*@
                        <div id="otp-screen">
                            @* 1.3.1 Info and Relationships — six single-character boxes
                               are one field split across six controls. The fieldset and
                               legend name the group; each box says which position it is,
                               so a screen reader user knows where they are.
                               1.3.5 — autocomplete="one-time-code" lets the OS offer the
                               SMS code. 3.3.2 — the format is stated up front. *@
                            <fieldset>
                                <legend class="a11y-visually-hidden">One-time code, six digits</legend>
                                <p id="otpHint" class="a11y-visually-hidden">
                                    Enter one digit in each of the six boxes. You can also paste the whole code into the first box.
                                </p>
                                <div class="form-row">
                                    <div class="col form-group">
                                        <label for="otp1" class="a11y-visually-hidden">Digit 1 of 6</label>
                                        @Html.TextBoxFor(m => m.otp1, new { autocomplete = "one-time-code", @inputmode = "numeric", @name = "otp1", @maxlength = "1", @id = "otp1", @class = "form-control text-center text-6 py-2", @required = "", @aria_required = "true", @aria_describedby = "otpHint" })
                                    </div>
                                    <div class="col form-group">
                                        <label for="otp2" class="a11y-visually-hidden">Digit 2 of 6</label>
                                        @Html.TextBoxFor(m => m.otp2, new { autocomplete = "off", @inputmode = "numeric", @maxlength = "1", @name = "otp2", @id = "otp2", @class = "form-control text-center text-6 py-2", @required = "", @aria_required = "true" })
                                    </div>
                                    <div class="col form-group">
                                        <label for="otp3" class="a11y-visually-hidden">Digit 3 of 6</label>
                                        @Html.TextBoxFor(m => m.otp3, new { @class = "form-control text-center text-6 py-2", autocomplete = "off", @inputmode = "numeric", @maxlength = "1", @name = "otp3", @id = "otp3", @required = "", @aria_required = "true" })
                                    </div>
                                    <div class="col form-group">
                                        <label for="otp4" class="a11y-visually-hidden">Digit 4 of 6</label>
                                        @Html.TextBoxFor(m => m.otp4, new { @class = "form-control text-center text-6 py-2", autocomplete = "off", @inputmode = "numeric", maxlength = "1", @name = "otp4", @id = "otp4", @required = "", @aria_required = "true" })
                                    </div>
                                    <div class="col form-group">
                                        <label for="otp5" class="a11y-visually-hidden">Digit 5 of 6</label>
                                        @Html.TextBoxFor(m => m.otp5, new { @class = "form-control text-center text-6 py-2", autocomplete = "off", @inputmode = "numeric", maxlength = "1", @name = "otp5", @id = "otp5", @required = "", @aria_required = "true" })
                                    </div>
                                    <div class="col form-group">
                                        <label for="otp6" class="a11y-visually-hidden">Digit 6 of 6</label>
                                        @Html.TextBoxFor(m => m.otp6, new { @class = "form-control text-center text-6 py-2", autocomplete = "off", @inputmode = "numeric", maxlength = "1", @name = "otp6", @id = "otp6", @required = "", @aria_required = "true" })
                                    </div>
                                </div>
                            </fieldset>
                            @*<button class="btn btn-primary btn-block my-4" type="button" id="btnOtpVerify">Verify</button>*@
                        </div>
                        @*@Html.TextBoxFor(m => m.token_no, new { @class = "form-control", @name = "access_token", @id = "access_token" })*@

                        <input class="btn btn-primary btn-block my-4" type="button" id="btnVerify" value="Verify code" />

                        @* 2.1.1 Keyboard / 4.1.2 — a control that only fires script is a
                           button. As an <a href="#" role="button"> it announced as a link to nowhere. *@
                        <p class="text-center mb-0">
                            Not received your code?
                            <button type="button" class="btn btn-link p-0" id="htdResendOTP">Resend code</button>
                        </p>
                        @*}*@
                    </form>
                    <br />
                    <div class="form-group form-primary">
                        @* 4.1.1 Parsing — a <p> inside an <a> was producing a block
                           element inside a phrasing context and swallowing the link
                           text. 2.4.4 — the link text now describes its destination. *@
                        <a href="/ClientPortal/Login/Index" class="float-label" style="display:inline-block; margin-top:-15px;">Go back to sign in</a>
                    </div>

                </div>
            </div>
        </div>
        <!-- end of form -->
    </div>
    <!-- end of col-sm-12 -->
</div>
