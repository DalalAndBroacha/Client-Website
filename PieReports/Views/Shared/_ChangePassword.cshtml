@model ViewModel.Login.dtoInputChangePassword
@*<div class="modal-dialog">
    <div class="modal-content">*@
<section class="login-block" aria-label="Change password">
    <div class="row" id="divchangePassword">
        <div class="col-sm-12">
            @*@using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post))
                {*@
            <div class="md-float-material form-material">
                @*<div class="md-float-material form-material">*@

                <div class="auth-box card">
                    <div class="card-block">
                        <div class="row m-b-20">
                            <div class="col-md-12">
                                <div class="text-center" id="divRedireLogin_ChangePassword">
                                    <a href="@Url.Action("Index", "Login")"><img src="~/images/logo.svg" alt="Dalal &amp; Broacha client portal home"></a>
                                </div>
                                <br />
                                                                <h2 class="text-center h4">
                                    <u>Change password</u>
                                </h2>
                                @*s <p>Welcome to PIE! For the security purpose, We recommended to change the password, on first login.</p>*@
                                @*expired  <p> For the security purpose, The password has expired, Hence recommended to change the password.</p>*@
                                @*forgot pass <p>For the security, Please remember the password. Do not share the anyone and keep it confidential. </p>*@
                            </div>
                        </div>


                        <div class="form-group form-primary">
                            @* 3.3.2 Labels or Instructions — explicit label association, and the
                               composition rules are announced through aria-describedby before
                               submission rather than after a rejection. 1.3.5 — the correct
                               autocomplete token for a new password. *@
                            <label class="float-label" for="txtNewPassword" style="font-weight:100;">New password <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                            <input type="password" id="txtNewPassword" class="form-control" minlength="8"
                                   autocomplete="new-password" required aria-required="true" aria-describedby="message">
                            <span class="form-bar"></span>
                        </div>
                        <div class="form-group form-primary">

                            <label class="float-label" for="txtConfirmPassword" style="font-weight:100;">Confirm new password <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                            <input type="password" id="txtConfirmPassword" class="form-control" minlength="8"
                                   autocomplete="new-password" required aria-required="true">
                            <span class="form-bar"></span>
                        </div>
                        @*<div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>*@
                    @* 4.1.3 Status Messages — announced as the user types, without
                           moving focus. *@
                    <div id="message" role="status" aria-live="polite">
                        <h3 class="h6">Your password must contain:</h3><br />

                        <p id="capital" class="pass_invalid">An Uppercase Letter (A-Z)</p>
                        <p id="letter" class="pass_invalid">A Lowercase Letter (a-z)</p>
                        <p id="sym" class="pass_invalid">A Special Characters (!@@#$%^&*)</p>
                        <p id="number" class="pass_invalid">A number (0-10)</p>
                        <p id="length" class="pass_invalid">Between 8-20 Characters</p>


                    </div>
                        <div class="form-group form-primary">
                            <div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>
                            @* 3.3.1 Error Identification — a live region, not a bare <label>
                                   that announced a control which does not exist. *@
                                <div role="alert" aria-live="assertive">
                                    <span class="msg" style="color: #b3241a"></span>
                                    <span style="font-variant-caps: all-petite-caps; color: #b3241a;" id="spnmsg"></span>
                                </div>
                        </div>
                        <div class="row m-t-25 text-left;">
                            <div class="col-md-12">
                                <div class="checkbox-fade fade-in-primary d-">
                                    @if (Model != null)
                                    {
                                        @if (Model.Flag != "deshboard")
                                        {
                                            <div class="form-group form-primary">
                                                <a href="/ClientPortal/Login/Index" class="float-label" style="display:inline-block; margin-top:-15px;">Go back to sign in</a>
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="forgot-phone text-right f-right">
                                    <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" disabled id="btnsub" type="submit" value="Change password" />
                                </div>
                            </div>
                        </div>
                        @*<div class="row m-t-30">
                                <div class="col-md-12">
                                    <div class="card-block">
                                        <div class="forgot-phone text-right f-right">
                                            <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Login" />
                                            </div>
                                    </div>
                                </div>


                            </div>*@

                        @*</div>*@
                    </div>
                </div>
            </div>
            @*}*@
        </div>
    </div>

</section>
@*<div class="modal-footer justify-content-between">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button>
    </div>*@
@*</div>
    </div>*@
