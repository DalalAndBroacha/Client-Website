@{
    var headerId = "header_div_" + @ViewBag.ReportHeaderDiv;
    var report_date = "report_date_" + @ViewBag.ReportHeaderDiv;
}

<div class="SubTotalRow row" id=@headerId>
    <div class="offset-2"></div>
    <div class="col-8 d-flex justify-content-center">
        <p style="text-align:center">
            @* 1.3.1 Info and Relationships / 2.4.6 Headings and Labels — the report
               name is the page heading. A native <h1> here would break out of the
               inline run of date text and change the layout, so the heading role
               and level are supplied explicitly instead. *@
            <b id="lblReport_Name" role="heading" aria-level="1">@ViewBag.ReportName</b>
            @if (ViewBag.GenDate == "True")
            {
                if (ViewBag.GenPeriod == "True")
                {
                    <b><b id="report_start_date"></b> to <b id="report_end_date"></b></b>
                    <br />
                }
                else
                {
                    
                    <b id="@report_date">@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b>
                    <br />
                }
            }
            <br />
            <span style="font-size:9px;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span>
        </p>
    </div>
    <div class="col-2">
        <div class="d-flex justify-content-end mt-2">
            @if (ViewBag.PrimaryReport != "True")
            {
                <button title="Back to previous Report" id=@ViewBag.ElementBackBtnID aria-label="Back to the previous report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                    <i class="fas fa-arrow-left" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            @*
        <button title="Print This Page" id=@ViewBag.ElementPrintBtnID onclick=@ViewBag.ElementPrintBtnOnClickEvent aria-label="Print this report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
            <i class="fas fa-print" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
        </button>*@

            @if (ViewBag.ElementPDFBtnID != null)
            {

                @if (ViewBag.PdfBackdropID != null)
                {
                    <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID data-toggle="modal" data-target="@ViewBag.PdfBackdropID" aria-label="Export this report to PDF" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID aria-label="Export this report to PDF" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            }
            @if (ViewBag.ElementExcelBtnID != null)
            {
                @if (ViewBag.ExcelBackdropID != null)
                {
                    <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID data-toggle="modal" data-target="@ViewBag.ExcelBackdropID" aria-label="Export this report to Excel" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID aria-label="Export this report to Excel" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            }
                
            @if (ViewBag.ElementEmailBtnID != null)
            {
                @if (ViewBag.EmailBackdropID != null)
                {
                    <button title="Email" id=@ViewBag.ElementEmailBtnID data-toggle="modal" data-target="@ViewBag.EmailBackdropID" aria-label="Email this report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
                else
                {
                    <button title="Email" id=@ViewBag.ElementEmailBtnID aria-label="Email this report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                        <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                    </button>
                }
            }
            </div>
    </div>
</div>


