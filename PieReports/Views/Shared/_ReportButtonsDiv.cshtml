<div id=@ViewBag.DivReportHead>
    <div class="SubTotalRow" style="text-align:center;">
        @if (ViewBag.DivReportHead == "EqDebtMFHeader")
        {
            <b id="bheSubCatEquityMF"></b>
        }
        @* 1.3.1 Info and Relationships / 2.4.6 Headings and Labels — the report
           name is the page heading. A native <h1> would break out of the inline
           run of date text and change the layout, so the heading role and level
           are supplied explicitly, matching the other report header partials. *@
        <b role="heading" aria-level="1">@ViewBag.ReportName</b>
        @if (ViewBag.FlagAsOnDate == "True" && ViewBag.DivReportHead == "OtherPMSHeader")
        {
            <b id="flagason"></b>
        }
        else
        {
            //Change here for Nav Date/Process Date
            <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b>
        }
        <br>
        <span style="font-size:9px;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span>

    </div>
    <nav class="navbar navbar-expand mb-mt SubTotalRow">
        <div style="width:70%">
            @if (ViewBag.L3Report == "False")
            {
                if (ViewBag.DivReportHead == "OtherPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Client: <b id=@ViewBag.ElementClientNameID></b>&emsp;Year:<b id=@ViewBag.ElementYearID></b><br />
                        Category: <b id=@ViewBag.ElementSubCategoryID></b>
                    </p>
                }
                else if (ViewBag.ReportName != "Performance Report" && ViewBag.ReportName != "SIP Summary Report" && ViewBag.DivReportHead != "EqPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Family: <b id=@ViewBag.ElementFamilyNameID></b>&nbsp;&nbsp;
                        Client: <b id=@ViewBag.ElementClientNameID></b> <b>(</b><b id=@ViewBag.ElementPANID></b><b>)</b>&nbsp;&nbsp;
                        Year:<b id=@ViewBag.ElementYearID></b>
                    </p>
                }
                else if (ViewBag.DivReportHead == "EqPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Total Corpus: <b id=ttlCorpus></b>&nbsp;&nbsp;Date of Joining: <b id=dateOfJoinin></b><br>
                        <b id=pmsClientName></b>
                    </p>
                }
                else
                {
                    <p style="margin-left:22px;margin-top:5px;">
                        Family: <b id=@ViewBag.ElementFamilyNameID></b>&emsp; Year: <b id=@ViewBag.ElementFinYearID></b>
                    </p>
                }
            }
            else
            {
                @*if (ViewBag.ElementScriptName != null)
            {
            <p>
            Client:<b id=@ViewBag.ElementClientNameID></b><br>
            Script Name:<b id=@ViewBag.ElementScriptName> </b>
            </p>
            }
            else if (ViewBag.SchemeName != null)
            {
            <p>
            Client:<b id=@ViewBag.ElementClientNameID></b><br>
            Scheme Name:<b id=@ViewBag.SchemeName> </b>
            </p>
            }*@
            }
        </div>
        <div style="width:30%" class="d-flex justify-content-end">
            @if (ViewBag.PrimaryReport != "True")
            {
                <button title="Back to Performance Report" id=@ViewBag.ElementBackBtnID aria-label="Back to the performance report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                    <i class="fas fa-arrow-left" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID aria-label="Export this report to PDF" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
            <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID aria-label="Export this report to Excel" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
            @*
            <button title="Print This Page" id=@ViewBag.ElementPrintBtnID onclick=@ViewBag.ElementPrintBtnOnClickEvent aria-label="Print this report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
            <i class="fas fa-print" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>*@
            <button title="Email" id=@ViewBag.ElementEmailBtnID aria-label="Email this report" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
                <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
            @*@if (ViewBag.PrimaryReport == "True")
            {
            <button title="Add to favourite" onclick="PerformanceUpdateFev()" id="PerformanceAddtoFavourite" aria-label="Add this report to favourites" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
            <i class="far fa-star" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
            </button>
            <button title="Add to favourite" onclick="PerformanceDeleteFev()" id="PerformanceRemoveFavourite" aria-label="Add this report to favourites" type="button" class="a11y-report-btn" style="border: 2px solid var(--a11y-action-red); padding: 0; background-color: var(--a11y-action-red);">
            <span class="strikethrough_icon"><i class="far fa-star" aria-hidden="true" style="color: white; padding:0; width:30px;"></i></span>
            </button>
            }*@

        </div>
    </nav>
</div>