<div id=@ViewBag.DivReportHead>
    <div class="SubTotalRow" style="text-align:center;">
        @if (ViewBag.DivReportHead == "EqDebtMFHeader")
        {
            <b id="bheSubCatEquityMF"></b>
        }
        <b>@ViewBag.ReportName</b>
        @if (ViewBag.FlagAsOnDate == "True" && ViewBag.DivReportHead == "OtherPMSHeader")
        {
            <b id="flagason"></b>
        }
        else
        {
            //Change here for Nav Date/Process Date
            <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b>
        }
        <br>
        <span style="font-size:9px;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span>

    </div>
    <nav class="navbar navbar-expand mb-mt SubTotalRow">
        <div style="width:70%">
            @if (ViewBag.L3Report == "False")
            {
                if (ViewBag.DivReportHead == "OtherPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Client: <b id=@ViewBag.ElementClientNameID></b>&emsp;Year:<b id=@ViewBag.ElementYearID></b><br />
                        Category: <b id=@ViewBag.ElementSubCategoryID></b>
                    </p>
                }
                else if (ViewBag.ReportName != "Performance Report" && ViewBag.ReportName != "SIP Summary Report" && ViewBag.DivReportHead != "EqPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Family: <b id=@ViewBag.ElementFamilyNameID></b>&nbsp;&nbsp;
                        Client: <b id=@ViewBag.ElementClientNameID></b> <b>(</b><b id=@ViewBag.ElementPANID></b><b>)</b>&nbsp;&nbsp;
                        Year:<b id=@ViewBag.ElementYearID></b>
                    </p>
                }
                else if (ViewBag.DivReportHead == "EqPMSHeader")
                {
                    <p style="margin-left:2px;margin-top:5px;">
                        Total Corpus: <b id=ttlCorpus></b>&nbsp;&nbsp;Date of Joining: <b id=dateOfJoinin></b><br>
                        <b id=pmsClientName></b>
                    </p>
                }
                else
                {
                    <p style="margin-left:22px;margin-top:5px;">
                        Family: <b id=@ViewBag.ElementFamilyNameID></b>&emsp; Year: <b id=@ViewBag.ElementFinYearID></b>
                    </p>
                }
            }
            else
            {
                @*if (ViewBag.ElementScriptName != null)
            {
            <p>
            Client:<b id=@ViewBag.ElementClientNameID></b><br>
            Script Name:<b id=@ViewBag.ElementScriptName> </b>
            </p>
            }
            else if (ViewBag.SchemeName != null)
            {
            <p>
            Client:<b id=@ViewBag.ElementClientNameID></b><br>
            Scheme Name:<b id=@ViewBag.SchemeName> </b>
            </p>
            }*@
            }
        </div>
        <div style="width:30%" class="d-flex justify-content-end">
            @if (ViewBag.PrimaryReport != "True")
            {
                <button title="Back to Performance Report" id=@ViewBag.ElementBackBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                    <i class="fas fa-arrow-left" style="color: white; padding:0; width:30px;"></i>
                </button>
            }
            <button title="Export to PDF" id=@ViewBag.ElementPDFBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="far fa-file-pdf" style="color: white; padding:0; width:30px;"></i>
            </button>
            <button title="Export to Excel" id=@ViewBag.ElementExcelBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="far fa-file-excel" style="color: white; padding:0; width:30px;"></i>
            </button>
            @*
            <button title="Print This Page" id=@ViewBag.ElementPrintBtnID onclick=@ViewBag.ElementPrintBtnOnClickEvent style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
            <i class="fas fa-print" style="color: white; padding:0; width:30px;"></i>
            </button>*@
            <button title="Email" id=@ViewBag.ElementEmailBtnID style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                <i class="fas fa-envelope" style="color: white; padding:0; width:30px;"></i>
            </button>
            @*@if (ViewBag.PrimaryReport == "True")
            {
            <button title="Add to favourite" onclick="PerformanceUpdateFev()" id="PerformanceAddtoFavourite" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
            <i class="far fa-star" style="color: white; padding:0; width:30px;"></i>
            </button>
            <button title="Add to favourite" onclick="PerformanceDeleteFev()" id="PerformanceRemoveFavourite" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
            <span class="strikethrough_icon"><i class="far fa-star" style="color: white; padding:0; width:30px;"></i></span>
            </button>
            }*@

        </div>
    </nav>
</div>