@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    // WCAG 2.4.2 Page Titled — every page supplies its own title, most
    // specific information first, because screen reader users hear the
    // beginning of the title and tab strips truncate the end.
    var pageTitle = ViewData["Title"] as string;
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Client Portal | Dalal & Broacha Stock Broking Pvt. Ltd."
        : pageTitle + " | Client Portal | Dalal & Broacha Stock Broking Pvt. Ltd.";

    // Post-login pages render ~/Pages/_Layout.cshtml, which sets this so the
    // AdminLTE shell classes land on the real <body> instead of the nested one
    // that partial used to emit. It travels through HttpContext.Items because
    // Html.RenderPartial gives a partial its own copy of ViewData.
    var bodyClass = Context.Items["BodyClass"] as string ?? "";

    // 2.2.1 Timing Adjustable — must match Startup.cs AddSession IdleTimeout.
    var sessionMinutes = Configuration.GetValue<int?>("SessionIdleTimeoutMinutes") ?? 30;
}

<!DOCTYPE html>
<!-- WCAG 3.1.1 Language of Page -->
<html lang="en">
<head>
    <title>@documentTitle</title>
    <link rel="icon" type="image/x-icon" href="~/images/logo_short.png" /> <!-- Favicon icon -->
    <!-- Meta -->
    <meta charset="utf-8">
    @* WCAG 1.4.4 Resize Text — user-scalable=0 blocked pinch zoom. Never
       suppress zoom; no maximum-scale, no user-scalable. *@
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Client Portal" />
    <meta name="keywords" content="Dalal and Broacha,Client Portal" />
    <meta name="author" content="codedthemes" />

    <!-- Google font-->
    @*<link href="https://fonts.googleapis.com/css?family=Roboto:400,500" rel="stylesheet">*@
    <!-- Required Fremwork -->
    <!-- <link rel="stylesheet" type="text/css" href="~/css/bootstrap/css/bootstrap.min.css">-->
    <!-- waves.css -->
    <link rel="stylesheet" href="~/pages/waves/css/waves.min.css" type="text/css" media="all">

    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/css/bootstrap.min.css" />
    <!-- themify-icons line icon -->
    <link rel="stylesheet" type="text/css" href="~/icon/themify-icons/themify-icons.css">
    <!-- ico font -->
    <link rel="stylesheet" type="text/css" href="~/icon/font-awesome/css/font-awesome.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <link rel="stylesheet" href="~/css/Allinone.css">
    @*<link rel="stylesheet" type="text/css" href="~/icon/icofont/css/icofont.css">*@
    <!-- Font Awesome -->
    <!-- Style.css -->
    <link href="~/css/jquery.mCustomScrollbar.css" rel="stylesheet" />
    <link href="~/css/export.css" rel="stylesheet" />
    @* asp-append-version fingerprints the URL. Without it these files are
       served with a stable URL and a warm browser cache keeps the
       pre-remediation copy — which would reinstate the suppressed focus
       outline (2.4.7) and the failing contrast values (1.4.3). The global
       AppendVersionTagHelperInitializer does not help here: LinkTagHelper
       only activates on links that already carry an asp- attribute. *@
    <link rel="stylesheet" type="text/css" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/Allinone.css">
    <script type="text/javascript" src="~/js/jquery/jquery.min.js"></script>
    @* <script src="~/js/jquery/jquerylatest.min.js"></script> *@
    <link href="~/css/IndexPage.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/responsive.css" rel="stylesheet" />

    @* Accessibility layer. Also re-linked at the end of <body> so it stays
       last in the cascade after @RenderSection("Styles"). *@
    <link rel="stylesheet" type="text/css" href="~/css/accessibility.css" asp-append-version="true" />

    @* Use to pass App settings values to Javascript files as global variables*@
    @{
        string myMessage = Configuration.GetValue<string>("gridPageNum");

        <script type="text/javascript">
            var globalDataGridPageLenght = @myMessage;
        </script>
    }
    @* Use to pass App settings values to Javascript files as global variables*@
</head>
<body class="@bodyClass">

    @* WCAG 2.4.1 Bypass Blocks — first focusable element in the DOM,
       off-screen until focused. *@
    <a class="a11y-skip-link" href="#main-content">Skip to main content</a>

    @* WCAG 4.1.3 Status Messages — the live regions must exist in the DOM,
       empty, before any text is written into them. Screen readers announce
       changes to an existing region, not the insertion of a populated one. *@
    <div id="a11y-status" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="a11y-alert" role="alert" aria-live="assertive" aria-atomic="true"></div>

    @RenderBody()

    @* WCAG 2.2.1 Timing Adjustable — the session expires after
       @sessionMinutes idle minutes. Warn a full minute out in a real dialog
       that takes focus, and offer at least 10 extensions. *@
    <div id="a11y-timeout-dialog" class="a11y-timeout-dialog" role="dialog" aria-modal="true"
         aria-labelledby="a11y-timeout-title" aria-describedby="a11y-timeout-desc" aria-hidden="true">
        <div class="a11y-timeout-dialog__panel">
            <h2 id="a11y-timeout-title">Your session is about to expire</h2>
            <p id="a11y-timeout-desc">
                For your security you will be signed out in
                <strong data-a11y-countdown>60 seconds</strong>.
                Choose <strong>Stay signed in</strong> to continue working.
            </p>
            <div class="a11y-timeout-dialog__actions">
                <button type="button" class="btn btn-danger" data-a11y-extend>Stay signed in</button>
                <button type="button" class="btn btn-secondary" data-a11y-logout>Sign out now</button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script type="text/javascript" src="~/js/jquery-ui/jquery-ui.min.js "></script>
    <script type="text/javascript" src="~/js/popper.js/popper.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap/js/bootstrap.min.js "></script>

    <script src="~/pages/widget/excanvas.js"></script>
    <script type="text/javascript" src="~/pages/waves/js/waves.min.js"></script>
    <!-- waves js -->
    <!-- jquery slimscroll js -->
    <script type="text/javascript" src="~/js/jquery-slimscroll/jquery.slimscroll.js "></script>
    <!-- modernizr js -->
     <script type="text/javascript" src="~/js/modernizr/modernizr.js"></script>
    <script type="text/javascript" src="~/js/SmoothScroll.js"></script>
    <script src="~/js/jquery.mCustomScrollbar.concat.min.js"></script>
    @* <script type="text/javascript" src="~/js/chart.js/Chart.js"></script>  *@


    <!-- amchart js -->
    <script src="~/js/amcharts.js"></script>
    <script src="~/pages/widget/amchart/gauge.js"></script>
    <script src="~/pages/widget/amchart/serial.js"></script>
    <script src="~/pages/widget/amchart/light.js"></script>
    <script src="~/pages/widget/amchart/pie.min.js"></script>
    <script src="~/js/export.min.js"></script>
    <!-- menu js -->
    <script src="~/js/pcoded.min.js"></script>
    <script src="~/js/vertical-layout.min.js "></script>
    <!-- custom js -->
    <!-- <script type="text/javascript" src="~/pages/dashboard/custom-dashboard.js"></script>-->
    <script type="text/javascript" src="~/js/script.js "></script>
    <script type="text/javascript" src="~/js/common-pages.js"></script>

    <!-- <script src="~/pages/waves/js/waves.min.js"></script>-->
    <!-- PAGE PLUGINS -->
    <!-- jQuery Mapael -->
    <script src="~/plugins/jquery-mousewheel/jquery.mousewheel.js"></script>
    <script src="~/plugins/raphael/raphael.min.js"></script>
    <script src="~/plugins/jquery-mapael/jquery.mapael.min.js"></script>
    <script src="~/plugins/jquery-mapael/maps/usa_states.min.js"></script>

    @RenderSection("Scripts", required: false)
    @RenderSection("Styles", required: false)

    @* Accessibility layer, last in the cascade and last in the script order
       so it can see everything the page and its plugins rendered. *@
    <link rel="stylesheet" type="text/css" href="~/css/accessibility.css" asp-append-version="true" />
    <script type="text/javascript">
        window.a11ySessionConfig = {
            timeoutMinutes: @sessionMinutes,
            logoutUrl: '@Url.Action("LogOut", "Login")',
            keepAliveUrl: '@Url.Action("KeepAlive", "Login")'
        };
    </script>
    <script src="~/js/accessibility.js" asp-append-version="true"></script>

    @* EnableUser accessibility widget (enablestack-widget 1.4.0), on every page,
       before and after sign-in. Installed with `npm install enablestack-widget`
       and themed at install time: brand colour #b3241a, icon "Accessibility
       person". That deeper Dalal & Broacha red keeps the widget's white icon
       and its lighter accent text above 4.5:1 (the logo red #ee3426 is 4.07:1
       with white). The themed build is vendored here, like the other client
       libraries. To change colour or icon, re-run
       `npx enablestack-widget-theme <hex> [icon]` and copy
       dist/enablestack-widget.js over this file. It renders inside a Shadow
       DOM, so it does not touch the portal's own styles.
       The launcher sits bottom-right: bottom-left (the default) lands on the
       sidebar menu after sign-in. *@
    <script>
        window.ENABLESTACK_CONFIG = { widgetPosition: { side: 'right' } };
    </script>
    <script src="~/lib/enablestack-widget/enablestack-widget.js" asp-append-version="true" defer></script>
</body>
</html>
