@model ViewModel.Login.ChangeUsername


@* 1.1.1 — decorative pre-loader, hidden from assistive technology. *@
<div class="theme-loader" aria-hidden="true">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Pre-loader end -->

<div class="row">
    <div class="col-sm-12">

        <div class="md-float-material form-material">

            <div class="auth-box card">
                <div class="card-block">
                    <div class="row m-b-20">
                        <div class="col-md-12">
                            <div class="text-center" id="divRedireLogin_ChangeUsername">
                                <a href="@Url.Action("Index","Login")"><img src="~/images/logo.svg" alt="Dalal &amp; Broacha client portal home"></a>
                            </div>
                            <br />
                            <h2 class="text-center h4">
                                Change Username
                            </h2>
                        </div>
                    </div>
                    <div class="form-group form-primary">
                        @*<input type="text" name="txtEmail" id="txtEmail" class="form-control" required="" @Model.Email>*@
                        @* 3.3.2 Labels or Instructions — a <label> with no `for` is not a
                           label. 1.4.1 — "required" is stated in text, not by a red
                           asterisk alone. 1.3.5 — a real autocomplete token. *@
                        @Html.TextBoxFor(m => m.new_username, new { autocomplete = "username", @type = "text", @name = "txtnew_username", @id = "txtnew_username", @class = "form-control", @required = "", @aria_required = "true", @aria_describedby = "spnmsguser" })
                        <span class="form-bar"></span>
                        @* The float-label must follow the input: it floats up via
                           `.form-control:focus ~ .float-label`. `for` carries the association. *@
                        <label class="float-label" for="txtnew_username" style="font-weight:100;">New Username <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                    </div>

                    <div class="form-group form-primary">
                        @* 3.3.1 Error Identification — the message element stays the original
                           <label> (it is styled per page and reserves the form's spacing); it
                           is tied to the field above via aria-describedby and announced
                           through aria-live. 1.4.3 — red (#ff0000) was 4.0:1; #b3241a is 6.9:1. *@
                        <label style="font-variant-caps: all-petite-caps;font-weight:100; color: #b3241a;" id="spnmsguser" aria-live="assertive" aria-atomic="true"></label>
                    </div>
                    <div class="row m-t-30" style="margin-top: 0px;">
                        <div class="col-md-12">
                            <div class="checkbox-fade fade-in-primary d-">
                                @if (Model != null)
                                {
                                    @if (Model.Flag != "deshboard")
                                    {
                                        <div class="form-group form-primary">
                                            <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-15px;pointer-events: inherit;">Go Back to Login</p></a>
                                        </div>
                                    }
                                }

                            </div>
                            <div class="forgot-phone text-right f-right">
                                @*<button type="button" class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20">Login</button>*@
                                <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="button" id="btnusernameForgote" value="Submit" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- end of col-sm-12 -->
</div>

<!-- end of container-fluid -->
