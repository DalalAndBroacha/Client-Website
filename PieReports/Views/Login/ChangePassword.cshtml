@model ViewModel.Login.dtoInputChangePassword
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Change your password";
}



@* 1.1.1 — decorative pre-loader, hidden from assistive technology. *@
<div class="theme-loader" aria-hidden="true">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>



@* 2.4.1 Bypass Blocks — skip-link target and main landmark. *@
<main id="main-content" tabindex="-1" class="login-block mb-mtop0">
    <div class="row" id="divchangePassword">
        <div class="col-sm-12">
            @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post))
            {
                <div class="md-float-material form-material">

                    <div class="auth-box card">
                        <div class="card-block">
                            <div class="row m-b-20">
                                <div class="col-md-12">
                                    <div class="text-center" id="divRedireLogin">
                                        <a href="@Url.Action("Index", "Login")"> <img src="~/images/logo.svg" class="img-responsive2" alt="Dalal &amp; Broacha client portal home"></a>
                                    </div>
                                    <br />
                                    @* 2.4.6 Headings and Labels — the page's single h1, and the reason
                                           the user was sent here is announced as a status. *@
                                    <h1 class="text-center h4">
                                        <u>Change your password</u>
                                    </h1>
                                    <div role="status" aria-live="polite">
                                        <h2 class="text-center text-danger h6">@Model.msg</h2>
                                    </div>
                                    @*s <p>Welcome to PIE! For the security purpose, We recommended to change the password, on first login.</p>*@
                                    @*expired  <p> For the security purpose, The password has expired, Hence recommended to change the password.</p>*@
                                    @*forgot pass <p>For the security, Please remember the password. Do not share the anyone and keep it confidential. </p>*@
                                </div>
                            </div>


                            <div class="form-group form-primary a11y-password-field">
                                @*<input type="password" class="form-control" required="">*@
                                @* 3.3.2 Labels or Instructions — explicit label, and the composition
                                   rules are stated before submission via aria-describedby.
                                   1.3.5 — autocomplete="new-password" is the correct token; a
                                   password manager needs it and autocomplete="off" fails. *@
                                <label class="float-label" for="txtChangeNewPassword">New password <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                @Html.TextBoxFor(m => m.NewPassword, new { autocomplete = "new-password", @type = "password", @name = "txtChangeNewPassword", @id = "txtChangeNewPassword", @class = "form-control", @required = "", @aria_required = "true", @maxlength = "20", @aria_describedby = "message" })
                                <span class="form-bar"></span>
                                @* 2.1.1 Keyboard / 4.1.2 — the reveal control is a toggle
                                   button with a pressed state, not an <a href="#" role="button">. *@
                                @* 1.4.10 Reflow — anchored to the field instead of a fixed 330px
                                       margin, which overflowed the viewport at 320 CSS px. *@
                                    <button type="button" id="changePassNewPassEye" class="btn btn-link a11y-password-toggle"
                                            aria-pressed="false" aria-controls="txtChangeNewPassword"
                                            aria-label="Show password"><i class="fa fa-eye-slash" aria-hidden="true"></i></button>
                            </div>
                            <div class="form-group form-primary">
                                @*<input type="password" class="form-control" required="">*@
                                <label class="float-label" for="txtConfirmNewPassword">Confirm new password <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                @Html.TextBoxFor(m => m.ConfirmPassword, new { autocomplete = "new-password", @type = "password", @name = "txtConfirmNewPassword", @id = "txtConfirmNewPassword", @class = "form-control", @required = "", @aria_required = "true", @maxlength = "20", @aria_describedby = "changePassMatchConfPass" })
                                <span class="form-bar"></span>
                            </div>
                            @*<div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>*@
                            @* 4.1.3 Status Messages — the checklist updates as the user types.
                                   role="status" announces each change without moving focus.
                                   1.4.1 — the CSS adds a check or cross glyph, so the pass/fail
                                   state is not signalled by colour alone. *@
                            <div id="message" role="status" aria-live="polite">
                                <h2 class="h6">Your password must contain:</h2><br />
                                <p id="ChangePasscapital" class="invalid">An UPPERCASE letter (A,B..Z)</p>
                                <p id="ChangePassletter" class="invalid">A lowercase letter (a,b..z)</p>
                                <p id="ChangePasssym" class="invalid">A Special Character (! @@ # $ % ^ & *)</p>
                                <p id="ChangePassnumber" class="invalid">A number (0,1..9)</p>
                                <p id="ChangePasslength" class="invalid">Minimum 8 characters</p>

                            </div>
                            <p id="changePassMatchConfPass" role="alert" style="display:none;" class="pass_invalid"></p>
                            <div class="form-group form-primary">
                                <div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>
                                @* 3.3.1 Error Identification — this was wrapped in a bare <label>,
                                       which announced a form control that does not exist. *@
                                    <div role="alert" aria-live="assertive">
                                        <span class="msg" style="color: #b3241a"></span>
                                        <span style="font-variant-caps: all-petite-caps; color: #b3241a;" id="spnmsg">@Model.sql_message</span>
                                    </div>
                                @*<a href="/ClientPortal/Login/Index" class="float-label" style="display:inline-block; margin-top:-6px; margin-left:15px;">Go back to sign in</a>*@
                            </div>
                            <div class="row m-t-25 text-left">
                                <div class="col-12">
                                    <div class="checkbox-fade fade-in-primary d-">
                                        @*<div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>
                    <label>
                        <span class="msg" style="color: #d81e1e" ;></span>
                        <span style="font-variant-caps: all-petite-caps; color: #b3241a;" id="spnmsg">@Model.sql_message</span>
                    </label>*@

                                        <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-6px; margin-left: 15px;pointer-events: inherit;">Go Back to Login</p></a>

                                    </div>
                                    <div class="forgot-phone text-right f-right">
                                        <input class="btn btn-success btn-md btn-block text-center m-b-20" id="btnchange" disabled type="submit" value="Change password" />
                                    </div>
                                </div>
                            </div>
                            @*<div class="row m-t-30">
            <div class="col-md-12">
                <div class="card-block">
                    <div class="forgot-phone text-right f-right">
                        <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Login" />
                        </div>
                </div>
            </div>


        </div>*@

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</main>



@*<link href="~/css/ForgotPassword.css" rel="stylesheet" />*@
<link href="~/css/ChangePassword.css" rel="stylesheet" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/Jquery/changePassword.js"></script>





