@model ViewModel.Login.dtoInputChangePassword


<div class="theme-loader">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>



<section class="login-block mb-mtop0">
    <div class="row" id="divchangePassword">
        <div class="col-sm-12">
            @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post))
            {
                <div class="md-float-material form-material">

                    <div class="auth-box card">
                        <div class="card-block">
                            <div class="row m-b-20">
                                <div class="col-md-12">
                                    <div class="text-center" id="divRedireLogin">
                                        <a href="@Url.Action("Index", "Login")"> <img src="~/images/logo.svg" class="img-responsive2" alt="logo"></a>
                                    </div>
                                    <br />
                                    <h4 class="text-center">
                                        <u>Change Password</u>
                                    </h4>
                                    <h6 class="text-center text-danger">@Model.msg</h6>
                                    @*s <p>Welcome to PIE! For the security purpose, We recommended to change the password, on first login.</p>*@
                                    @*expired  <p> For the security purpose, The password has expired, Hence recommended to change the password.</p>*@
                                    @*forgot pass <p>For the security, Please remember the password. Do not share the anyone and keep it confidential. </p>*@
                                </div>
                            </div>


                            <div class="form-group form-primary">
                                @*<input type="password" class="form-control" required="">*@
                                @Html.TextBoxFor(m => m.NewPassword, new { autocomplete = "off", @type = "password", @name = "txtChangeNewPassword", @id = "txtChangeNewPassword", @class = "form-control", @required = "", @maxlength = "20" })
                                <span class="form-bar"></span>
                                <label class="float-label">
                                    New Password
                                </label>
                                <div class="input-group-addon" style="margin-left: 330px; margin-top: -34px;">
                                    <a href="#" id="changePassNewPassEye"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                </div>
                            </div>
                            <div class="form-group form-primary">
                                @*<input type="password" class="form-control" required="">*@
                                @Html.TextBoxFor(m => m.ConfirmPassword, new { autocomplete = "off", @type = "password", @name = "txtConfirmNewPassword", @id = "txtConfirmNewPassword", @class = "form-control", @required = "", @maxlength = "20" })
                                <span class="form-bar"></span>
                                @*<span class="msg" style="color: #d81e1e" ;></span>*@
                                <label class="float-label">
                                    Confirm Password
                                </label>
                            </div>
                            @*<div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>*@
                            <div id="message">
                                <h6>Password must contain:</h6><br />
                                <p id="ChangePasscapital" class="invalid">An UPPERCASE letter (A,B..Z)</p>
                                <p id="ChangePassletter" class="invalid">A lowercase letter (a,b..z)</p>
                                <p id="ChangePasssym" class="invalid">A Special Character (! @@ # $ % ^ & *)</p>
                                <p id="ChangePassnumber" class="invalid">A number (0,1..9)</p>
                                <p id="ChangePasslength" class="invalid">Minimum 8 characters</p>

                            </div>
                            <p id="changePassMatchConfPass" style="display:none;" class="pass_invalid"></p>
                            <div class="form-group form-primary">
                                <div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>
                                <label>
                                    <span class="msg" style="color: #d81e1e" ;></span>
                                    <span style="font-variant-caps: all-petite-caps; color: red;" id="spnmsg">@Model.sql_message</span>
                                </label>
                                @*<a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-15px;pointer-events: inherit;">Go Back to Login</p></a>*@
                            </div>
                            <div class="row m-t-25 text-left">
                                <div class="col-12">
                                    <div class="checkbox-fade fade-in-primary d-">
                                        @*<div class="registrationFormAlert" style="color:green;" id="CheckPasswordMatch"></div>
                    <label>
                        <span class="msg" style="color: #d81e1e" ;></span>
                        <span style="font-variant-caps: all-petite-caps; color: red;" id="spnmsg">@Model.sql_message</span>
                    </label>*@

                                        <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-6px; margin-left: 15px;pointer-events: inherit;">Go Back to Login</p></a>

                                    </div>
                                    <div class="forgot-phone text-right f-right">
                                        <input class="btn btn-success btn-md btn-block text-center m-b-20" id="btnchange" disabled type="submit" value="Change" />
                                    </div>
                                </div>
                            </div>
                            @*<div class="row m-t-30">
            <div class="col-md-12">
                <div class="card-block">
                    <div class="forgot-phone text-right f-right">
                        <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Login" />
                        </div>
                </div>
            </div>


        </div>*@

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</section>



@*<link href="~/css/ForgotPassword.css" rel="stylesheet" />*@
<link href="~/css/ChangePassword.css" rel="stylesheet" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/Jquery/changePassword.js"></script>





