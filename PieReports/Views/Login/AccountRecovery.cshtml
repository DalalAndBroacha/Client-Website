@model ViewModel.Login.InputForgotUser;
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Forgot username";
}


    @* 1.1.1 — decorative pre-loader, hidden from assistive technology. *@
    <div class="theme-loader" aria-hidden="true">
        <div class="loader-track">
            <div class="preloader-wrapper">
                <div class="spinner-layer spinner-blue">
                    <div class="circle-clipper left">
                        <div class="circle"></div>
                    </div>
                    <div class="gap-patch">
                        <div class="circle"></div>
                    </div>
                    <div class="circle-clipper right">
                        <div class="circle"></div>
                    </div>
                </div>
                <div class="spinner-layer spinner-red">
                    <div class="circle-clipper left">
                        <div class="circle"></div>
                    </div>
                    <div class="gap-patch">
                        <div class="circle"></div>
                    </div>
                    <div class="circle-clipper right">
                        <div class="circle"></div>
                    </div>
                </div>

                <div class="spinner-layer spinner-yellow">
                    <div class="circle-clipper left">
                        <div class="circle"></div>
                    </div>
                    <div class="gap-patch">
                        <div class="circle"></div>
                    </div>
                    <div class="circle-clipper right">
                        <div class="circle"></div>
                    </div>
                </div>

                <div class="spinner-layer spinner-green">
                    <div class="circle-clipper left">
                        <div class="circle"></div>
                    </div>
                    <div class="gap-patch">
                        <div class="circle"></div>
                    </div>
                    <div class="circle-clipper right">
                        <div class="circle"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* 2.4.1 Bypass Blocks — skip-link target and main landmark. *@
    <main id="main-content" tabindex="-1" role="main">
    <section class="login-block mb-mtop0" id="divOtpHide" aria-label="Forgot username">
        <!-- Container-fluid starts -->
        @*<div class="container">*@

        @if (Model.sql_status == "Success" && Model.response=="1")
        {
            <input id="txtemailotp" name="txtemailotp" hidden value="@Model.email_id" />
            <input id="txtmobileotp" name="txtmobileotp" hidden value="@Model.mobile_number" />
            <input id="txtAccountotp" name="txtAccountotp" hidden value="@Model.account_code" />
            <input id="txtPanotp" name="txtPanotp" hidden value="@Model.pan_number" />
            Html.RenderPartial("_OTPPartial", Model.otps);
        }

        @if (Model.sql_status == null || Model.sql_status == "Fail")
            {
            <div class="row">
                <div class="col-sm-12">


                    @using (Html.BeginForm("AccountRecovery", "Login", FormMethod.Post))
                    {
                        <div class="md-float-material form-material">
                            @*<div class="text-center">
                                <img src="~/images/logo.png" alt="logo.png">
                            </div>*@
                            <div class="auth-box card">
                                <div class="card-block">
                                    <div class="row m-b-20">
                                        <div class="col-md-12">
                                            <div class="text-center" id="divRedireLogin">
                                                <a href="@Url.Action("Index", "Login")"> <img src="~/images/logo.svg" class="img-responsive2" alt="Dalal &amp; Broacha client portal home"></a>
                                            </div>
                                            <br />
                                            @* 2.4.6 Headings and Labels — the page's single h1. *@
                                            <h1 class="text-center h4">
                                                Forgot Username
                                            </h1>
                                        </div>
                                    </div>


                                    <div class="form-group form-primary">
                                        @*<input type="text" name="email" id="txtemail" class="form-control" required="">*@
                                        @* 3.3.2 Labels or Instructions — a <label> with no `for` is not a
                                           label. 1.3.5 — a real autocomplete token replaces
                                           autocomplete="off" on a personal-data field. 2.4.3 —
                                           positive tabindex removed. 1.4.1 — "required" in text. *@
                                        @Html.TextBoxFor(m => m.email_id, new { autocomplete = "email", @type = "text", @inputmode = "email", @name = "txtemail", @id = "txtemail", @class = "form-control", @required = "", @aria_required = "true", @aria_describedby = "txtemail-msg" })
                                        <span class="form-bar"></span>
                                        @* The float-label must follow the input: it floats up via
                                           `.form-control:focus ~ .float-label`. `for` carries the association. *@
                                        <label class="float-label" for="txtemail">Email Id <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                        @* 3.3.1 Error Identification — tied to the field, announced. *@
                                        <span class="msg" id="txtemail-msg" role="alert" style="color: #d81e1e"></span>
                                    </div>
                                    <div class="form-group form-primary">
                                        @* 3.3.2 — state the length constraint before submission, not after. *@
                                        @Html.TextBoxFor(m => m.mobile_number, new { autocomplete = "tel", minlength = "8", maxlength = "12", @type = "tel", @inputmode = "numeric", @name = "txtmobile", @id = "txtmobile", @class = "form-control", @required = "", @aria_required = "true", @aria_describedby = "txtmobile-hint txtmobile-msg" })
                                        <span class="form-bar"></span>
                                        @* The float-label must follow the input: it floats up via
                                           `.form-control:focus ~ .float-label`. `for` carries the association. *@
                                        <label class="float-label" for="txtmobile">Mobile No <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                        <p id="txtmobile-hint" class="a11y-visually-hidden">8 to 12 digits.</p>
                                        <span class="msgg" id="txtmobile-msg" role="alert" style="color: #d81e1e"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="auth-box card" style=" margin-top: -30px;">
                                <div class="card-block">
                                    @if (Model.response == "2")
                                    {
                                        <div class="form-group form-primary">
                                            @*<input type="text" name="pan" autocomplete="off" class="form-control" required="">*@
                                            @Html.TextBoxFor(m => m.pan_number, new { autocomplete = "off", @type = "text", @name = "txtPan", @id = "txtPan", @class = "form-control", @maxlength = "10", @aria_describedby = "txtPan-hint" })
                                            <span class="form-bar"></span>
                                            @* The float-label must follow the input: it floats up via
                                               `.form-control:focus ~ .float-label`. `for` carries the association. *@
                                            <label class="float-label" for="txtPan">PAN No <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                            <p id="txtPan-hint" class="a11y-visually-hidden">Ten characters, for example ABCDE1234F.</p>
                                        </div>
                                    }
                                    <div class="form-group form-primary">
                                            @* 3.3.1 Error Identification — the result of the lookup, in text.
                                               It stays the original <label> (it sets the form's spacing); a
                                               label with no control is not announced as one. *@
                                            <label aria-live="assertive" aria-atomic="true">
                                                @if (Model.response == "0")
                                                {
                                                    <span style="color: #d81e1e"> User not found</span>
                                                }
                                                else
                                                {
                                                    <span style="color: #d81e1e">@Model.sql_message</span>
                                                }
                                            </label>
                                            </div>
                                    <div class="row m-t-25 text-left">
                                        <div class="col-md-12">
                                            @* <div class="card-block" style=" margin-left: -18px;">*@
                                            <div class="checkbox-fade fade-in-primary d-">
                                                <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-15px; margin-left: 15px;pointer-events: inherit;">Go Back to Login</p></a>
                                            </div>
                                            <div class="forgot-phone text-right f-right">
                                                @*<button type="button" class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20">Submit</button>*@
                                                <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Submit" />
                                            </div>
                                        </div>
                                        @* </div>*@


                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </section>
    </main>

    <section class ="login-block" id="seUserNAme" aria-label="Set a new username">
      
    @Html.Partial("_ChangeUsername", Model.changeUsername);
      

        </section>
        @*<script src="~/Jquery/ForgotUser.js" asp-append-version="true"></script>*@
        @*<script src="../../Jquery/ForgotUser.js"></script>*@
        <script src="~/Jquery/ForgotUser.js" asp-append-version="true"></script> 
