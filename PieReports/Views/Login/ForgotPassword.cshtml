@model ViewModel.Login.ForgotPassword 

<div class="theme-loader">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>




<section class="login-block mb-mtop0">
    @if (Model.sql_status == "Success")
    {
        <input id="txttxtUsername" name="txttxtUsername" hidden value="@Model.Username" />
        <input id="txttxtEmailId" name="txttxtEmailId" hidden value="@Model.EmailId" />
        Html.RenderPartial("_OTPPartial", Model.otps);
    }
    @if (Model.sql_status == null || Model.sql_status == "Fail")
    {

        <div class="row">
            <div class="col-sm-12">


                @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
                {

                    <div class="md-float-material form-material">
                        <div class="auth-box card">
                            <div class="card-block">
                                <div class="row m-b-20">
                                    <div class="col-md-12">
                                        <div class="text-center" id="divRedireLogin">
                                            <a href="@Url.Action("Index", "Login")"> <img src="~/images/logo.svg" class="img-responsive2" alt="logo"></a>
                                        </div>
                                        <br />
                                        <h4 class="text-center">
                                            Forgot Password
                                        </h4>
                                    </div>
                                </div>
                                <div class="form-group form-primary">
                                    @*<input type="text" name="email" class="form-control" autocomplete="off" required="">*@
                                    @Html.TextBoxFor(m => m.Username, new { autocomplete = "off", @type = "text", @name = "txtUsername", @id = "txtUsername", @class = "form-control", @required = "", @tabindex = "1" })
                                    <span class="form-bar"></span>
                                    <label class="float-label">Username <span style="color:red;">*</span></label>
                                </div>
                                <div class="form-group form-primary">
                                    @*<input type="text" name="email" id="txtemail" autocomplete="off" class="form-control" required="">*@
                                    @Html.TextBoxFor(m => m.EmailId, new { autocomplete = "off", @type = "text", @name = "txtEmailId", @id = "txtEmailId", @class = "form-control", @required = "", @tabindex = "2" })
                                    <span class="form-bar"></span>
                                    <span class="msg" style="color: #d81e1e" ;></span>
                                    <label class="float-label">
                                        Email Id <span style="color:red;">*</span>
                                    </label>
                                </div>
                                <div class="form-group form-primary">
                                    @if (Model.sql_message != null)
                                    {
                                        <p id="headerdata">@Model.sql_message</p>
                                    }
                                    </div>
                                    <div class="row m-t-25 text-left">
                                        <div class="col-md-12">
                                            <div class="checkbox-fade fade-in-primary d-">
                                                <a href="/ClientPortal/Login/Index" tabindex="4">  <p class="float-label" style="margin-top:-6px; margin-left:15px; pointer-events: inherit; ">Go Back to Login</p></a>
                                            </div>


                                            <div class="forgot-phone text-right f-right">
                                                <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Submit" tabindex="3" />
                                            </div>

                                        </div>


                                    </div>
                                    @*<div class="form-group form-primary">
                <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-15px;pointer-events: inherit;">Go Back to Login</p></a>
            </div>*@

                                </div>
                            </div>
                    </div>
                }
            </div>
        </div>
    }


</section>

<script src="~/Jquery/ForgotPassword.js"></script>