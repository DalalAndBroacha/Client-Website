@model ViewModel.Login.ForgotPassword 
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Forgot password";
}


@* 1.1.1 — decorative pre-loader, hidden from assistive technology. *@
<div class="theme-loader" aria-hidden="true">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>




@* 2.4.1 Bypass Blocks — skip-link target and main landmark. *@
<main id="main-content" tabindex="-1" class="login-block mb-mtop0">
    @if (Model.sql_status == "Success")
    {
        <input id="txttxtUsername" name="txttxtUsername" hidden value="@Model.Username" />
        <input id="txttxtEmailId" name="txttxtEmailId" hidden value="@Model.EmailId" />
        Html.RenderPartial("_OTPPartial", Model.otps);
    }
    @if (Model.sql_status == null || Model.sql_status == "Fail")
    {

        <div class="row">
            <div class="col-sm-12">


                @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
                {

                    <div class="md-float-material form-material">
                        <div class="auth-box card">
                            <div class="card-block">
                                <div class="row m-b-20">
                                    <div class="col-md-12">
                                        <div class="text-center" id="divRedireLogin">
                                            <a href="@Url.Action("Index", "Login")"> <img src="~/images/logo.svg" class="img-responsive2" alt="Dalal &amp; Broacha client portal home"></a>
                                        </div>
                                        <br />
                                        @* 2.4.6 Headings and Labels — the page's single h1. It was an <h4>,
                                           which skipped levels and left the page with no
                                           top-level heading. *@
                                        <h1 class="text-center h4">
                                            Forgot Password
                                        </h1>
                                    </div>
                                </div>
                                <div class="form-group form-primary">
                                    @*<input type="text" name="email" class="form-control" autocomplete="off" required="">*@
                                    @* 3.3.2 Labels or Instructions — a <label> with no `for` is not a
                                       label. 1.3.5 — a real autocomplete token replaces
                                       autocomplete="off". 2.4.3 — positive tabindex
                                       removed; DOM order is already correct. 1.4.1 — the
                                       required state is stated in text, not by colour. *@
                                    @Html.TextBoxFor(m => m.Username, new { autocomplete = "username", @type = "text", @name = "txtUsername", @id = "txtUsername", @class = "form-control", @required = "", @aria_required = "true" })
                                    <span class="form-bar"></span>
                                    @* The float-label must follow the input: it floats up via
                                       `.form-control:focus ~ .float-label`. `for` carries the association. *@
                                    <label class="float-label" for="txtUsername">Username <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                </div>
                                <div class="form-group form-primary">
                                    @*<input type="text" name="email" id="txtemail" autocomplete="off" class="form-control" required="">*@
                                    @Html.TextBoxFor(m => m.EmailId, new { autocomplete = "email", @type = "text", @inputmode = "email", @name = "txtEmailId", @id = "txtEmailId", @class = "form-control", @required = "", @aria_required = "true", @aria_describedby = "txtEmailId-msg" })
                                    <span class="form-bar"></span>
                                    @* The float-label must follow the input: it floats up via
                                       `.form-control:focus ~ .float-label`. `for` carries the association. *@
                                    <label class="float-label" for="txtEmailId">Email Id <span class="a11y-required-marker" aria-hidden="true">*</span><span class="a11y-visually-hidden"> (required)</span></label>
                                    @* 3.3.1 Error Identification — associated with the field it
                                       describes and announced when script writes into it. *@
                                    <span class="msg" id="txtEmailId-msg" role="alert" style="color: #d81e1e"></span>
                                </div>
                                <div class="form-group form-primary">
                                    @* 4.1.3 Status Messages — announced without moving focus. *@
                                    <div role="status" aria-live="polite">
                                        @if (Model.sql_message != null)
                                        {
                                            <p id="headerdata">@Model.sql_message</p>
                                        }
                                    </div>
                                    </div>
                                    <div class="row m-t-25 text-left">
                                        <div class="col-md-12">
                                            <div class="checkbox-fade fade-in-primary d-">
                                                <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-6px; margin-left:15px; pointer-events: inherit;">Go Back to Login</p></a>
                                            </div>


                                            <div class="forgot-phone text-right f-right">
                                                <input class="btn btn-primary btn-md btn-block waves-effect waves-light text-center m-b-20" type="submit" value="Submit" />
                                            </div>

                                        </div>


                                    </div>
                                    @*<div class="form-group form-primary">
                <a href="/ClientPortal/Login/Index">  <p class="float-label" style="margin-top:-15px;pointer-events: inherit;">Go Back to Login</p></a>
            </div>*@

                                </div>
                            </div>
                    </div>
                }
            </div>
        </div>
    }


</main>

<script src="~/Jquery/ForgotPassword.js"></script>