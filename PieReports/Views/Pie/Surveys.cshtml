@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Surveys";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {
    <link href="~/css/Service Modules/Survey.css" rel="stylesheet" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @* 1.3.1 / 2.4.6 — the design shows no page name, so the page
           heading is provided for assistive technology only and is kept
           in step with the <title> set at the top of this view. *@
        <h1 class="a11y-visually-hidden">@ViewData["Title"]</h1>
        <div style="position:unset; background-color:white; padding:0.5rem;">

            <div class="row justify-content-center">
                <div class="col-4">
                    <label for="ddlSurveyList" class="a11y-visually-hidden">Survey</label>
                    <select style="border: 1px solid #cccccc; height:38px;" class="form-control mb-1" id="ddlSurveyList">
                    </select>
                </div>
                <div class="col-2">
                    <button onclick="ViewSurveys()" class="btn DnB-RedLabel">View Survey</button>
                </div>
            </div>

            <hr style="border: 1px solid #ee3426;" class="mt-0" />

            <div class="row justify-content-center mt-1" style="height:73vh">
                <div class="col-10 surveyContainer" id="surveyCont">
                    <div class="surveyQuesTabs">
                        <p>
                            Regular communication of the Investment opportunities received from D & B For following.
                            Please select option that most accurately reflects your satisfaction level.
                        </p>
                        <table class="table w-100">
                            <colgroup>
                                <col style="width:30%">
                                <col style="width:11%">
                                <col style="width:11%">
                                <col style="width:11%">
                                <col style="width:11%">
                                <col style="width:11%">
                                <col style="width:11%">
                            </colgroup>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">Excellent</th>
                                <th scope="col">Very Good</th>
                                <th scope="col">Acceptable</th>
                                <th scope="col">Fair</th>
                                <th scope="col">Poor</th>
                                <th scope="col">Not Applicable</th>
                            </tr>
                            <tr class="table-active">
                                <td>Equity</td>
                                <th scope="col"><input type="radio" name="S1Q1" value="1"></th>
                                <th scope="col"><input type="radio" name="S1Q1" value="2"></th>
                                <th scope="col"><input type="radio" name="S1Q1" value="3"></th>
                                <th scope="col"><input type="radio" name="S1Q1" value="4"></th>
                                <th scope="col"><input type="radio" name="S1Q1" value="5"></th>
                                <th scope="col"><input type="radio" name="S1Q1" value="0"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Mutual Fund</td>
                                <th scope="col"><input type="radio" name="S1Q2" value="1"></th>
                                <th scope="col"><input type="radio" name="S1Q2" value="2"></th>
                                <th scope="col"><input type="radio" name="S1Q2" value="3"></th>
                                <th scope="col"><input type="radio" name="S1Q2" value="4"></th>
                                <th scope="col"><input type="radio" name="S1Q2" value="5"></th>
                                <th scope="col"><input type="radio" name="S1Q2" value="0"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Fixed Income product</td>
                                <th scope="col"><input type="radio" name="S1Q3" value="1"></th>
                                <th scope="col"><input type="radio" name="S1Q3" value="2"></th>
                                <th scope="col"><input type="radio" name="S1Q3" value="3"></th>
                                <th scope="col"><input type="radio" name="S1Q3" value="4"></th>
                                <th scope="col"><input type="radio" name="S1Q3" value="5"></th>
                                <th scope="col"><input type="radio" name="S1Q3" value="0"></th>
                            </tr>
                            <tr class="table-active">
                                <td>PMS & AIF</td>
                                <th scope="col"><input type="radio" name="S1Q4" value="1"></th>
                                <th scope="col"><input type="radio" name="S1Q4" value="2"></th>
                                <th scope="col"><input type="radio" name="S1Q4" value="3"></th>
                                <th scope="col"><input type="radio" name="S1Q4" value="4"></th>
                                <th scope="col"><input type="radio" name="S1Q4" value="5"></th>
                                <th scope="col"><input type="radio" name="S1Q4" value="0"></th>
                            </tr>
                        </table>
                    </div>
                    <div class="surveyQuesTabs">
                        <p>
                            This questionnaire is issued on a rating system from poor to excellent, service.
                            Please select option that most accurately reflects your satisfaction level.
                        </p>
                        <table class="table w-100">
                            <colgroup>
                                <col style="width:30%">
                                <col style="width:14%">
                                <col style="width:14%">
                                <col style="width:14%">
                                <col style="width:14%">
                                <col style="width:14%">
                            </colgroup>
                            <tr>
                                <td></td>
                                <th scope="col"><div>Excellent</div></th>
                                <th scope="col"><div>Very Good</div></th>
                                <th scope="col"><div>Acceptable</div></th>
                                <th scope="col"><div>Fair</div></th>
                                <th scope="col"><div>Poor</div></th>
                            </tr>
                            <tr class="table-active">
                                <td>Response to the Enquiries</td>
                                <th scope="col"><input type="radio" name="S2Q1" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q1" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q1" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q1" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q1" value="5"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Frequency of Communication as per Expectations</td>
                                <th scope="col"><input type="radio" name="S2Q2" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q2" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q2" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q2" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q2" value="5"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Quality of service provided</td>
                                <th scope="col"><input type="radio" name="S2Q3" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q3" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q3" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q3" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q3" value="5"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Response to your request/suggestions</td>
                                <th scope="col"><input type="radio" name="S2Q4" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q4" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q4" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q4" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q4" value="5"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Response to the problems/complaints</td>
                                <th scope="col"><input type="radio" name="S2Q5" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q5" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q5" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q5" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q5" value="5"></th>
                            </tr>
                            <tr class="table-active">
                                <td>Service Delivery performance</td>
                                <th scope="col"><input type="radio" name="S2Q6" value="1"></th>
                                <th scope="col"><input type="radio" name="S2Q6" value="2"></th>
                                <th scope="col"><input type="radio" name="S2Q6" value="3"></th>
                                <th scope="col"><input type="radio" name="S2Q6" value="4"></th>
                                <th scope="col"><input type="radio" name="S2Q6" value="5"></th>
                            </tr>
                        </table>
                    </div>
                    <div class="surveyQuesTabs">
                        <p>
                            D&B offers website, which enables you to view your portfolio & Investments from your web browser
                        </p>
                        <input type="radio" id="S3Yes" name="fav_language" value="1">
                        <label for="S3Yes">Yes, I am aware.</label><br>
                        <input type="radio" id="S3No" name="fav_language" value="0">
                        <label for="S3No">No, I am not aware. Please, Send me the details.</label><br>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Jquery/Services/Surveys.js"></script>