@using ViewModel.Login
@using Newtonsoft.Json
@model ViewModel.ClientComms.coms_exceptions_model
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    var a11yPageTitle = "Client communication exceptions";
    ViewData["Title"] = a11yPageTitle;
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
    <link href="~/css/datatableselect.min.css" rel="stylesheet" />
    <link href="~/css/dormant.css" rel="stylesheet" asp-append-version="true" />
    @* <link href="~/css/Reports/GlobalReport.css" rel="stylesheet" asp-append-version="true" /> *@
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @{
            ViewBag.ReportName = "Exceptions";
            ViewBag.ReportHeaderDiv = "CommsException";
            ViewBag.GenDate = "False";

            ViewBag.PrimaryReport = "True";
            ViewBag.ElementPDFBtnID = null;
            ViewBag.ElementExcelBtnID = "btnCliComExceptionXls";
            ViewBag.ElementEmailBtnID = "btnCliComExceptionMail";

            ViewBag.ElementBackBtnID = null;

            <partial name="_ReportHeaderCompact"></partial>

            ViewData.Clear();
                // WCAG 2.4.2 Page Titled — Clear() also removes ViewData["Title"],
                // which Views/Shared/_Layout.cshtml renders into <title>.
                ViewData["Title"] = a11yPageTitle;
        }

        <div id="GlobalwaitIn" style="width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>
        <div id="main_div" style="position:unset; background-color:white !important; padding:1rem;">
            <div class="d-flex row justify-content-center mb-2">
                <div class="input-group mb-1 ml-3 col-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel" for="ddlExceptionList">Category</label>
                    </div>
                    <select class="form-control" style="border: 1px solid #ced4da; height:38px;" id="ddlExceptionList">

                        <option value="All">All</option>
                        @foreach (var key in Model.exception_reason_list)
                        {
                            <option value=@key.exception_reason>@key.exception_reason</option>
                        }

                    </select>
                </div>
            </div>
            <div class="" id="divInvalidEmail">
                <div id="divInvalid" style="padding:0.5rem; max-height:80vh; display:none;">
                    <div style="padding:0.5rem; overflow-y:scroll; overflow-x:auto; max-height:50vh;">
                        <table id="tblDataInvalid" class="table table-bordered w-100">
                            <thead>
                                <tr>
                                    <th scope="col">Code</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Last Activity</th>
                                    <th scope="col">E-Mail</th>
                                    <th scope="col">Mobile</th>
                                    <th scope="col">Exception</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var key in Model.data_list)
                                {
                                    <tr>
                                        <td class="paraTextAlignCenter align-middle">@key.trading_code</td>
                                        <td class="paraTextAlignCenter align-middle">@key.client</td>
                                        <td class="paraTextAlignCenter align-middle">
                                            <p>
                                                BSE : @key.bse_status<br>
                                                NSE : @key.nse_status<br>
                                            </p>
                                        </td>
                                        <td class="paraTextAlignCenter align-middle">
                                            <p>
                                                Trade : @key.dsp_last_traded_date<br>
                                                Re-KYC : @key.dsp_last_ReKYC_date<br>
                                                Agreement : @key.dsp_last_agreement_date<br>
                                            </p>
                                        </td>
                                        @if (key.exception_reason == "Invalid E-mail / Mobile")
                                        {
                                            <td class="paraTextAlignCenter align-middle">@key.email</td>
                                            <td class="paraTextAlignCenter align-middle">@key.mobile_no</td>
                                        }
                                        else
                                        {
                                            <td class="paraTextAlignCenter align-middle"></td>
                                            <td class="paraTextAlignCenter align-middle"></td>
                                        }
                                        <td class="paraTextAlignCenter align-middle">@key.exception_reason</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                </div>
            

        </div>
    </div>
</div>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>
<script src="~/hyper/js/vendor/datatables.select.min.js"></script>
<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>
<script src="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.js"></script>

<script src="~/Jquery/Services/ClientCommsException.js" asp-append-version="true"></script>