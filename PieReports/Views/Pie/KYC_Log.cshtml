@model ViewModel.Reports.Global_Report.initGlobalReport
@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    var a11yPageTitle = "KYC log";
    ViewData["Title"] = a11yPageTitle;
}

@{ string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">

        <div id="GlobalwaitIn" class="a11y-loading-indicator" style="display:none; width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>

        <div style="position:unset; background-color:white; padding:0.5rem;">

            <div class="d-flex justify-content-center">
                <div class="col-2">
                    <label for="inpStartDate">Start Date</label>
                    <input class="form-control" type="date" id="inpStartDate">
                </div>
                <div class="col-2">
                    <label for="inpEndDate">End Date</label>
                    <input class="form-control" type="date" id="inpEndDate" disabled>
                </div>
                <div class="offset-1 col-2 mt-4">
                    <button onclick="ViewLog()" class="btn btn-sm DnB-RedLabel">View Report</button>
                </div>
            </div>

            <div id="main_div" class="mt-2" style="display:none;">

                @{
                    ViewBag.ReportName = "KYC Log";
                    ViewBag.ReportHeaderDiv = "KYC_Log";
                    ViewBag.GenDate = "False";
                    ViewBag.GenPeriod = "False";

                    ViewBag.PrimaryReport = "True";
                    ViewBag.ElementPDFBtnID = null;
                    ViewBag.ElementExcelBtnID = "btnLogExcel";
                    ViewBag.ElementEmailBtnID = null;

                    ViewBag.ElementBackBtnID = null;

                    Html.RenderPartial("_ReportHeaderCompact");
                    ViewData.Clear();
                // WCAG 2.4.2 Page Titled — Clear() also removes ViewData["Title"],
                // which Views/Shared/_Layout.cshtml renders into <title>.
                ViewData["Title"] = a11yPageTitle;
                }

                <table id="KYC_Log_Table" class="table mt-2 table-hover w-100 table-bordered">
                    <thead>
                        <tr>
                            <th scope="col"><b>Request Id</b></th>
                            <th scope="col"><b>Client Name</b></th>
                            <th scope="col"><b>Account Code</th>
                            <th scope="col"><b>Income update</b></th>
                            <th scope="col"><b>New Income value</b></th>
                            <th scope="col"><b>E-mail update</b></th>
                            <th scope="col"><b>New E-mail value</b></th>
                            <th scope="col"><b>Mobile Update</b></th>
                            <th scope="col"><b>New Mobile Value</b></th>
                            <th scope="col"><b>Request Date</b></th>
                            <th scope="col"><b>Request Completion Date</b></th>
                            <th scope="col"><b>Remarks</b></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyKYC_Log">
                    </tbody>
                </table>


            </div>

        </div>

    </div>
</div>


<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>

<script src="~/Jquery/KYC/KYC_Log.js"></script>