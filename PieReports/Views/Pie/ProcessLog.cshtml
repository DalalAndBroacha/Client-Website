@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Process log";
}

@{ string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {
    <link href="~/css/bootstrap/css/bootstrap-multiselect.min.css" rel="stylesheet" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">

        <div id="ProcwaitIn" class="a11y-loading-indicator" style="display:none;width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>

        @{

            ViewBag.ReportName = "Process Log";
            ViewBag.ReportHeaderDiv = "ProcessLog";
            ViewBag.GenDate = "False";

            Html.RenderPartial("_ReportHeader");
        }

        <div style="position:unset; background-color:white; padding:0.5rem;">


            @*<div class="row">

                <div class="offset-2 col-4">
                    <select name="myOption" id="testSelect" multiple>
                        <option value="1">Equity</option>
                        <option value="2">Mutual Funds</option>
                        <option value="3">Bonds</option>
                        <option value="4">PMS</option>
                    </select>
                </div>

                <div class="col-4">
                    <button class="btn btn-sm btn-info ml-4" onclick="Printvals()">Values</button>
                </div>
            </div>*@



            <div class="d-flex justify-content-center">
                <div class="input-group mb-1 col-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel" for="ddlDBList">Database</label>
                    </div>
                    <select style="border: 1px solid #cccccc; height:38px; width:auto;" class="form-control" id="ddlDBList">
                        <option value="Pie" selected>PIE</option>
                        <option value="Pie Process">Pie Process</option>
                    </select>
                </div>
            </div>

            <div id="div_dsp_table" class="mt-1">
                <table id="Proc_Dsp_table" style="display: none;" class="table table-redbordered table-hover">
                    <colgroup>
                        <col style="width: 15%; text-align:center;">
                        <col style="width: 70%; text-align:left;">
                        <col style="width: 15%; text-align:center;">
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Remarks</th>
                            <th scope="col">Copy Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyProc_Dsp_table">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/js/bootstrap/js/bootstrap-multiselect.min.js"></script>
<script src="~/Jquery/Services/ProcessLog.js"></script>