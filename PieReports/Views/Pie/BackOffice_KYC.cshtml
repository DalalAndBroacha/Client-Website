@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Back-office KYC update";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
    <link href="~/css/BackOffice_KYC.css" rel="stylesheet" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @{

            ViewBag.ReportName = "Backoffice KYC Update";
            ViewBag.ReportHeaderDiv = "KYCupdateBackOffice_Module";
            ViewBag.GenDate = "False";

            Html.RenderPartial("_ReportHeader");
        }

        <div style="padding:5px;" class="card">
            <div class="card-header">
                <table id="req_table" class="table table-bordered table-hover" style="display:none;">
                    <colgroup>
                        <col style="width: 2%;">
                        <col style="width: 8%;">
                        <col style="width: 8%;">
                        <col style="width: 8%;">
                        <col style="width: 23%;">
                        <col style="width: 23%;">
                        <col style="width: 10%;">
                        <col style="width: 10%;">
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Request Id</th>
                            <th scope="col">Request Date</th>
                            <th scope="col">Client Name</th>
                            <th scope="col">Account Code</th>
                            <th scope="col">Old Values</th>
                            <th scope="col">New Values</th>
                            <th scope="col">Remarks</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyReqTable">
                    </tbody>
                </table>
            </div>
            <div style="display:none;" id="noRecordsFound">
                <p class="alert text-center alert-danger">No records found.</p>
            </div>
        </div>
    </div>
</div>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>
<script src="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.js"></script>


<script src="~/Jquery/KYC/BackOffice_KYC.js"></script>