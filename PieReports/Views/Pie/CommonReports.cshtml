@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Common reports";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@* @section Styles {
     <link asp-append-version="true" href="~/css/Reports/GlobalReport.css" rel="stylesheet" /> 

     psp_dsp_common_report_module_list
} *@

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @* 1.3.1 / 2.4.6 — the design shows no page name, so the page
           heading is provided for assistive technology only and is kept
           in step with the <title> set at the top of this view. *@
        <h1 class="a11y-visually-hidden">@ViewData["Title"]</h1>
        <div style="position:unset; background-color:white; padding:0.5rem;">
            <div class="d-flex justify-content-center">
                <div class="input-group mb-1 offset-2 col-md-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel"  for="ddlRepot">Report</label>
                        <select id="ddlRepot">
                        </select>
                    </div>
                </div>
                <div class="input-group mb-1 offset-2 col-md-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel"  for="ddlExportType">Export Type</label>
                        <select id="ddlExportType" class="select2">
                            <option value="1" selected>PDF</option>
                            <option value="2">Excel</option>
                        </select>
                    </div>
                </div>
                <div class="input-group mb-1 col-md-2">
                    <button id="btnGenRepo" type="button" onclick="generateReport()" class="btn DnB-RedLabel">Generate Report</button>
                </div>

            </div>
        </div>
    </div>
</div>

<script asp-append-version="true" src="~/Jquery/Services/CommonReports.js"></script>