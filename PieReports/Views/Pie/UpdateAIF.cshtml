@model ViewModel.Reports.RPT
@using ViewModel.Login
@using Newtonsoft.Json
@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>
    (dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}


@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />

}

<div class="wrapper">
    <div class="content-wrapper">

        <div style="position:unset; background-color:white; padding:0.5rem">
            <div id="div_dsptable" class="mt-3" style="display:none">
                <form>
                    <div class="row">
                        <div class="input-group mb-1 col-4">
                            <div class="input-group-prepend">
                                <label class="input-group-text DnB-RedLabel">Date</label>
                            </div>
                            <input type='date' id='nav_date' class='form-control'>
                        </div>
                        <div class="mb-1 offset-5 col-3">
                            <div class="input-group-prepend">
                                <button type="button" class="btn DnB-RedLabel" id="btn_Add_New" onclick="showform()" style="display:none">Add New</button>
                            </div>
                       </div>
                    </div>
                    <div id="div_add_data" class="mt-3 p-1" style="border: 3px solid #ced4da;">
                        <table class="table table-bordered dt-responsive w-100" id="display_table">
                            <thead>
                                <tr>
                                    <th>Scheme</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody id="tbodydsp_table">
                            </tbody>
                        </table>

                        <div class="mb-1 row">
                            <button type="button" class="btn DnB-RedLabel offset-9" onclick="ADDAIFData()" id="btn_Submit">Submit</button>
                        </div>
                    </div>

                    <div id="modify_nav_data" class="mt-3 p-1" style="display: none; border: 3px solid #ced4da;">
                        <table class="table table-bordered dt-responsive w-100" id="table_inp">
                            <colgroup>
                                <col style="width: 47%;">
                                <col style="width: 12%;">
                                <col style="width: 13%;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Scheme Name</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><select id="ddlAIFSchemeList" class="form-control mb-3"></select></td>
                                    <td><input type="number" id="inp_nav" class="form-control"></td>
                                    <td class="text-center" style="width:121px;">
                                        <input type="text" id="inp_rec_id_nav" value="0" hidden />
                                        <button class="btn" type="button" onclick="ADDAIFData()" title="Add"><i class="fas fa-plus-square fa-lg White_Red_Icon"></i></button>
                                        <button class="btn" type="button" onclick="Resetdata()" title="Clear"><i class="fas fa-broom fa-lg White_Red_Icon"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </form>

                <div id="div_dspnavtable" class="mt-3">
                    <table class="table table-bordered dt-responsive w-100" id="display_nav_table">
                        <thead>
                            <tr>
                                <th>Transaction Date</th>
                                <th>Scheme Name</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="tbodynavdsp_table">
                        </tbody>
                    </table>
                </div>

            </div>
        @*<div style="background-color:white !important; padding:5px;">

            <div class="row" id="divinput content">
                <div class="input-group mb-1 col-2">
                    <input type="date" id="inp_date" class="form-control">
                </div>

                <div class="input-group mb-1 col-6">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel" for="ddlAIFSchemeList">Scheme</label>
                    </div>
                    <select id="ddlAIFSchemeList"></select>
                </div>

                <div class="input-group mb-1 col-2">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel" for="txt_Cat">Nav</label>
                    </div>
                    <input type="text" class="form-control" id="txt_Nav">
                </div>
            </div>*@

        </div>
    </div>
    </div>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

