@model ViewModel.Reports.RPT;

@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Performance report";
}

@{ string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard); }

@section Styles {

    <link href="~/css/Reports/PerformanceReport.css" rel="stylesheet" asp-append-version="true" />
}


<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @*Loader*@
        <div id="waitIn" class="a11y-loading-indicator" style="display:none;width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>
        @*Loader*@

        @*Initial Page*@
        <div id="myModalst_PerformanceLandingPage" style="position: unset; background-color: white;">
            @{
                ViewBag.ReportName = "Performance Report";
                ViewBag.DivReportHead = "PerfHeader";
                ViewBag.FlagAsOnDate = "False";
                ViewBag.PrimaryReport = "True";
                ViewBag.L3Report = "False";

                ViewBag.ElementFamilyNameID = "bfamilyName";
                ViewBag.ElementFinYearID = "bFinYear";

                ViewBag.ElementPDFBtnID = "btnExportPdf";
                ViewBag.ElementExcelBtnID = "btnExportExcel";
                ViewBag.ElementEmailBtnID = "btnEMailMainPerfSummary";

                ViewBag.ElementPrintBtnID = null;

                ViewBag.ElementPrintBtnOnClickEvent = "print('#PrintPerfo')";


                ViewBag.ElementBackBtnID = null;

                Html.RenderPartial("_ReportButtonsDiv");
            }
            <input type="text" id="Curr_Family_Id" hidden />
            <section class="content" id="PrintPerfo">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card card-table-grid" style="height: auto;">
                                <div class="card-header p-2">
                                    <ul class="nav nav-pills-tab" id="noshow">
                                        <li class="nav-item"><a class="nav-link active" href="#timeline" data-toggle="tab">Family</a></li>
                                        <li class="nav-item"><a class="nav-link" href="#activity" data-toggle="tab">Client</a></li>
                                    </ul>
                                </div>
                                <div class="card-body p-0 table-responsive" id="hideshow">

                                    <div class="tab-content" id="binddata">
                                        <div class="tab-pane" id="activity">
                                            <table id="htmltopdf" class="table w-100 text-nowrap">

                                                <tbody id="tbodyBindingPerformance">
                                                </tbody>
                                            </table>


                                        </div>
                                        <div class="tab-pane active" id="timeline">

                                            <table class="table table-head-fixed w-100 text-nowrap" style="position: unset;">
                                                <thead>
                                                    <tr>
                                                        <th class="TableHeaderRow" scope="col"><p><b>Sub Category</b></p></th>
                                                        <th class="TableHeaderRow " scope="col"><p><b>Contribution</b></p></th>
                                                        <th class="TableHeaderRow " scope="col"><p><b>Holding Cost </b></p></th>
                                                        <th class="TableHeaderRow " scope="col"><p><b>Market Value</b></p></th>
                                                        <th class="TableHeaderRow " scope="col"><p style="width:max-content"><b>% Holding</b></p></th>

                                                        <th class="TableHeaderRow" scope="col"><p><b>Unrealised<br />Short Term<br />Profit /</b><b style="color: #9b1c14;">(Loss)</b></p></th>
                                                        <th class="TableHeaderRow" scope="col"><p><b>Unrealised<br />Long Term<br>Profit/</b><b style="color: #9b1c14;">(Loss)</b></p></th>

                                                        <th class="TableHeaderRow" scope="col"><p><b>Realised<br />Short Term<br />Profit /</b><b style="color: #9b1c14;">(Loss)</b></p></th>
                                                        <th class="TableHeaderRow" scope="col"><p><b>Realised<br />Long Term<br>Profit/</b><b style="color: #9b1c14;">(Loss)</b></p></th>

                                                        <th class="TableHeaderRow" scope="col"><p><b>Total<br />Short Term<br />Profit /</b><b style="color: #9b1c14;">(Loss)</b></p></th>
                                                        <th class="TableHeaderRow" scope="col"><p><b>Total<br />Long Term<br>Profit/</b><b style="color: #9b1c14;">(Loss)</b></p></th>

                                                        <th class="TableHeaderRow" scope="col"><p><b>Dividend<br>/Interest</b></p></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyBindingPerformanceAll">
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div id="noReFoundPerformance"></div>
                                    @*</div>*@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        @*Initial end*@

