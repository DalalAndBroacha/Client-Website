@model ViewModel.Reports.RPT;

@using ViewModel.Login
@using Newtonsoft.Json
@{ string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}


<div id="waitInIncome" style="display: none;width: 69px; height: 89px; border: 1px solid black; position: absolute; top: 50%; left: 50%; padding: 2px;"><img src="~/images/loader.gif" width="64" height="64" /><br>Loading..</div>

    <div class="content-wrapper">

        @*<div class="card" style="margin-top: 69px;">*@
        <nav class="navbar navbar-expand mb-mtop0" style="margin-top:60px;">
            <h3 class="main-title1 mb-mleft0" style="margin-left:27px;margin-top:7px;">Income Report</h3><br />
             

        <ul class="navbar-nav ml-auto">
            <li class="nav-item dropdown" id="IncomeAddtoFavourite">
                <a class="nav-link" onclick="IncomeUpdateFev()" data-toggle="dropdown" href="#" aria-expanded="true">
                    <span><img src="~/images/AddtoFavourite.png" style="width:27px;" /></span>
                </a>

            </li>
            <li class="nav-item dropdown" id="IncomeRemoveFavourite">
                <a class="nav-link" onclick="IncomeDeleteFev()" data-toggle="dropdown" href="#" aria-expanded="true">
                    <span><img src="~/images/RemoveFavourite.png" id="removefev" style="width:27px;" /></span>
                </a>

            </li>
            <li class="nav-item dropdown" id="liRemoveFavourite">
                <a class="nav-link" onclick="" data-toggle="dropdown" href="#" aria-expanded="true">
                    <span><img src="~/images/ShareIcon1.png" id="removefev" style="width:27px;" /></span>
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="left: inherit; right: 0px;">
                    <div class="form-group-dashboard">

                        <p id="btnIncomeExport" name="loginname" class="dropdown-item" style="background-color:#ffb3b3;font-size:12px;">
                            <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                ExporttoExcel
                            </a>
                        </p>
                    </div>
                    <div class="dropdown-divider"></div>
                    <div class="form-group-dashboard">
                        <p id="btnExportPdf" name="Changepassword" data-toggle="modal" class="dropdown-item">
                            <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                ExporttoPdf
                            </a>
                        </p>
                    </div>
                    <div class="dropdown-divider"></div>
                    <div class="form-group-dashboard">
                        <p onclick="print('#PrintIncome')" name="trading" data-toggle="modal" class="dropdown-item">
                            <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                Print
                            </a>
                        </p>
                    </div>
                    <div class="dropdown-divider"></div>
                   
                </div>
            </li>
        </ul>
        </nav>
        <section class="content" id="PrintIncome">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <p style="margin-left:25px;">FinYear:<b id="bFinYear"></b> &nbsp;&nbsp;  Family:<b id="bfamilyName"></b><span style="float:right;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span></p>

                            <div class="card-body table-responsive p-0  modal-panel-body" style="height: 600px;" id="hideshow">
                                <table class="table table-head-fixed text-nowrap popup-grid1">
                                    <thead>
                                        <tr>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Client</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Category<br />SubCategory</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Interest</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Dividend</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Short-Term<br /> Profit/</b><b style="color:red;">(Loss)</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Long-Term <br />Profit/</b><b style="color:red;">(Loss) </b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Long-Term Profit/</b><b style="color:red;">(Loss)</b><b><br />GrandFathering</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Realised <br />Profit/</b><b style="color:red;">(Loss)</b></p></th>
                                            <th style="background-color:#ffb3b3;vertical-align:top;border: 1px solid #dddddd;"><p><b>Taxable <br />Profit/</b><b style="color:red;">(Loss)</b></p></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyBinding" style="background-color:#ffe6e6;">
                                    </tbody>
                                </table>
                            </div>
                            <div id="noReFound"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>


<div class="modal fade" id="myModalst_pnl">
