                                            <p id="btnIncomeRealisedProfitLossReportExport" name="loginname" class="dropdown-item" style="background-color:#ffb3b3;font-size:12px;">
                                                <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                                    ExporttoExcel
                                                </a>
                                            </p>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                        <div class="form-group-dashboard">
                                            <p id="btnIncomeRealisedProfitLossReportPdf" name="Changepassword" data-toggle="modal" class="dropdown-item">
                                                <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                                    ExporttoPdf
                                                </a>
                                            </p>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                        <div class="form-group-dashboard">
                                            <p onclick="print('#myModalst_pnl')" name="trading" data-toggle="modal" class="dropdown-item">
                                                <a href="#" onclick="" style="font-family: inherit; font-size: 15px;">
                                                    Print
                                                </a>
                                            </p>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                    </div>
                                </li>
                            </ul>

                        </div>
                    </div>
                </div>

                <table class="table popup-grid1">
                    <thead>

                        <tr style="background-color:#ffb3b3;" id="tbodyBindingrealisedHeader"></tr>
                        
                    <tr style="background-color:#ffe6e6;">
                        <th style="background-color: #ffb3b3;border: 1px solid #dddddd;"></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="3"><p class="tableheading"><b>BUY</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="3"><p class="tableheading"><b>SELL</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="4"><p class="tableheading"><b>Profit/</b><b style="color:red;">(Loss)</b></p></th>
                    </tr>
                    <tr>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Qty.</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Date</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Rate</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Amount</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Date</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Rate</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Amount</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Intraday</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Short term</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Long term</b></p></th>
                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;"><p class="tableheading"><b>Total</b></p></th>
                    </tr>
                    </thead>

                    <tbody id="tbodyBindingrealised">
                    </tbody>
                </table>
                <div id="noReFoundrealised"></div>
            </div>
           
        </div>
    </div>
</div>
