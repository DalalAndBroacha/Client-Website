@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    var a11yPageTitle = "Equity ledger, current financial year";
    ViewData["Title"] = a11yPageTitle;
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        <div class="p-1">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-center">
                        <ul class="navbar" style="margin-bottom:0px !important">
                            <li class="nav-item mr-2">
                                <label for="ddlClientList" class="control-label">Client</label>
                            </li>
                            <li class="nav-item mr-2">
                                <select class="form-control select2 placeholder w-100" id="ddlClientList">
                                </select>
                            </li>
                            <li class="nav-item">
                                <button type="button" onclick="ViewData()" class="btn DnB-RedLabel">View Data</button>
                            </li>
                        </ul>
                    </div>
                    <div id="divLedgerTable" style="display:none">
                        @{
                            ViewBag.ReportName = "Equity Current FY Ledger";
                            ViewBag.ReportHeaderDiv = "CurrFY_Ledger";
                            ViewBag.GenDate = "False";
                            ViewBag.GenPeriod = "False";

                            ViewBag.PrimaryReport = "True";
                            ViewBag.ElementPDFBtnID = "btnCurrFYLedgerPdf";
                            ViewBag.ElementExcelBtnID = "btnCurrFYLedgerExcel";
                            ViewBag.ElementEmailBtnID = "btnEMailCurrFYLedger";

                            ViewBag.ElementBackBtnID = null;


                            <partial name="_ReportHeaderCompact"></partial>

                            //Html.RenderPartial("_ReportHeaderCompact");
                            ViewData.Clear();
                // WCAG 2.4.2 Page Titled — Clear() also removes ViewData["Title"],
                // which Views/Shared/_Layout.cshtml renders into <title>.
                ViewData["Title"] = a11yPageTitle;
                        }
                        <div class="mt-2">
                            <table class="table w-100 table-bordered table-hover" id="tableCurrFYEqLedger">
                                <thead>
                                    <tr>
                                        <th scope="col">Date</th>
                                        <th scope="col">Exchange</th>
                                        <th scope="col">Narration</th>
                                        <th scope="col">Doc. No.</th>
                                        <th scope="col">Debit</th>
                                        <th scope="col">Credit</th>
                                        <th scope="col">Balance</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodytableCurrFYEqLedger">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>

<script src="~/Jquery/Reports/CurrFYEqLedger.js"></script>