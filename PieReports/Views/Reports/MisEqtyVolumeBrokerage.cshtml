@using ViewModel.Login
@using Newtonsoft.Json
@model ViewModel.Shared.DisplayEqScripHolCliList
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Equity volume and brokerage MIS";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
    <link href="~/css/datatableselect.min.css" rel="stylesheet" />

    <link href="~/css/reports/equityanalytics.css" rel="stylesheet" asp-append-version="true" />
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @{

            ViewBag.ReportName = "Volume and Brokerage";
            ViewBag.ReportHeaderDiv = "EqVolBrokerage";
            ViewBag.GenDate = "False";

            <partial name="_ReportHeader" />
        }
        <div id="GlobalwaitIn" class="a11y-loading-indicator" style="display:none; width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="Loading..." />
        </div>

        <div id="main_div" style="position:unset; background-color:white !important; padding:1rem;">

            <div id="paramsTray">

                <div class="row justify-content-start">
                    <div class="input-group mb-0 col-md-5">
                        <div class="input-group-prepend">
                            <label class="input-group-text DnB-RedLabel mb-2" for="ddlBHRMList">
                                Select Branch or RM
                            </label>
                            <select class="form-control select2" id="ddlBHRMList" style="border-right: 1px solid black;
                                border-top: 1px solid black; border-bottom: 1px solid black;">

                                @if (Model.BH_RM_list != null)
                                {
                                    @foreach (var key in Model.BH_RM_list)
                                    {
                                        <option value="@key.login_id">@key.display_name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="input-group mb-0 col-md-6 justify-content-between">
                        <div class="input-group-prepend">
                            <label class="input-group-text DnB-RedLabel mb-2" for="inpFromDate">
                                From Date
                            </label>
                            <input type="date" class="form-control" id="inpFromDate">                        
                        </div>

                        <div class="input-group-prepend">
                            <label class="input-group-text DnB-RedLabel mb-2" for="inpToDate">
                                To Date
                            </label>
                            <input type="date" class="form-control" id="inpToDate">
                        </div>
                    </div>
                </div>

                <div class="row mt-1">
                    <div class="input-group col-md-10">
                        <div class="input-group-prepend">
                            <label class="input-group-text DnB-RedLabel" for="ddlScripList">
                                Select Scrip
                            </label>
                            <select class="form-control select2" id="ddlScripList" multiple>
                                @if (Model.script_list != null)
                                {
                                    @foreach (var key in Model.script_list)
                                    {
                                        <option value="@key.scrip_code">@key.SCRIP_NAME</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-md-2">
                        <button type="button" onclick="ViewData()" class="btn DnB-RedLabel ml-2">View Report</button>
                    </div>
                </div>

                <hr class="redHR mt-2 mb-2" />

            </div>

            <div id="divDataTable" style="display:none; padding:0.5rem; max-height:80vh;">
                
                <div id="divDataTblComponent" style="padding:0.5rem; overflow-y:scroll; overflow-x:auto; max-height:65vh;">
                    <div class="SubTotalRow row mb-2" id="_EqMISReportHeaderCompact">
                        <div class="offset-2"></div>
                        <div class="col-8 d-flex justify-content-center">
                        </div>
                        <div class="col-2">
                            <div class="d-flex justify-content-end mt-1 mb-1">

                                <button title="Toggle Report Parameters" id="btnParams" aria-label="Toggle report parameters" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                                    <i class="fas fa-sliders-h" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                                </button>


                                <button title="Export to Excel" id="btnExcel" aria-label="Export to Excel" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                                    <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                                </button>

                                <button title="Email" id="btnEmail" aria-label="Email" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                                    <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                                </button>

                            </div>
                        </div>
                    </div>
                    <table id="tblData" class="table table-bordered w-100">
                        <thead>
                            <tr>
                                <th scope="col">Scrip Name</th>
                                <th scope="col">Branch</th>
                                <th scope="col">Buy Qty</th>
                                <th scope="col">Buy Client</th>
                                <th scope="col">Sell Qty</th>
                                <th scope="col">Sell Client</th>
                                <th scope="col">Buy Volume</th>
                                <th scope="col">Sell Volume</th>
                                <th scope="col">Brokerage</th>
                                <th scope="col">Branch Client Count</th>
                                <th scope="col">Client Scrip Holding</th>
                                <th scope="col">Client Scrip Holding Count</th>                                
                            </tr>
                        </thead>
                        <tbody id="tbodyData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>
<script src="~/hyper/js/vendor/datatables.select.min.js"></script>
<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>
<script src="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.js"></script>

<script src="~/Jquery/Reports/MisEqtyVolumeBrokerage.js" asp-append-version="true"></script>
