@model ViewModel.Reports.RPT;

@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Asset allocation report";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/css/Reports/PerformanceReport.css" rel="stylesheet" asp-append-version="true" />
}


<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        <input type="text" id="Curr_Family_Id" hidden />
        @*Loader*@
        <div id="waitIn" class="a11y-loading-indicator" style="display:none;width:69px;height:69px;border:1px solid black;position:relative;top:50%;left:50%">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>
        @*Loader*@

        @*First Page*@
        <div id="AssetAllocationLandingPage" style="position: unset; background-color: white;">
            @{
                ViewBag.ReportName = "Asset Allocation Report";
                ViewBag.GenDate = "True";
                ViewBag.GenPeriod = "False";

                ViewBag.ElementPDFBtnID = "btnExportPdfAssetAllocation";
                ViewBag.ElementExcelBtnID = "btnExportExcelAssetAllocation";
                ViewBag.ElementEmailBtnID = "btnEMailAssetAllocation";

                ViewBag.PrimaryReport = "True";


                ViewBag.ElementBackBtnID = null;

                Html.RenderPartial("_ReportHeaderCompact");
            }
            <div style="position:unset; background-color:white; padding:0.5rem" id="all_report">
                <div class="row align-items-start">
                    <div class="input-group mb-1 col-12">
                       @*  <p id="FamilyName"></p> *@
                        <h6 id="Report_head">Family: <span id="FamilyName" style="font-weight:bold"></span>&nbsp;&nbsp;&nbsp; | &nbsp;&nbsp;&nbsp; Fin Year: <span id="Fin_year" style="font-weight:bold"></span></h6>
                    </div>
                </div>
                <br><br>
                <div class="row align-items-start">
                    <div class="input-group mb-1 col-6">
                        <h6 style="font-weight:bold">Asset Allocation Categorywise</h6>
                        <table class="table table-redbordered w-100" id="SummaryData">
                            <colgroup>
                                <col style="width: 40%;">
                                <col style="width: 30%;">
                                <col style="width: 20%;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th scope="col">Category</th>
                                    <th scope="col">Holding</th>
                                    <th scope="col">Holding %</th>
                                </tr>
                            </thead>
                            <tbody id="Summary_Familywise">
                            </tbody>
                        </table>
                    </div>

                    <div class="input-group mb-1 offset-1 col-5">
                        <canvas id="Summarychart" style="max-width:500px !important; max-height:500px !important"></canvas>

                    </div>
                </div>

                <hr class="redHR"/>

                <div class="row align-items-start">
                    <div class="input-group mb-1 col-6">
                        <h6 style="font-weight:bold">Asset Allocation Clientwise</h6>
                        <table class="table table-redbordered w-100" id="ClientwiseData" style="padding:0.5rem">
                            <colgroup>
                                <col style="width: 50%;">
                                <col style="width: 30%;">
                                <col style="width: 20%;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th scope="col">Client name</th>
                                    <th scope="col">Holding</th>
                                    <th scope="col">Holding %</th>
                                </tr>
                            </thead>
                            <tbody id="ClientWise_data">
                            </tbody>
                        </table>
                    </div>

                    <div class="input-group mb-1 offset-1 col-5">
                        <canvas id="ClientWiseDataChart" style="max-width:500px !important; max-height:500px !important"></canvas>
                    </div>
                </div>

                <hr class="redHR" />

                <div class="row align-items-start">
                    <div class="input-group mb-1 col-6">
                        <h6 style="font-weight:bold">Asset Allocation Client Categorywise</h6>
                        <table class="table table-redbordered w-100" id="ClientCategoryWiseData" style="padding:0.5rem">
                            <colgroup>
                                <col style="width: 40%;">
                                <col style="width: 30%;">
                                <col style="width: 20%;">
                            </colgroup> 
                            <thead>
                                <tr>
                                    <th scope="col">Category</th>
                                    <th scope="col">Holding</th>
                                    <th scope="col">Holding %</th>
                                </tr>
                            </thead> 
                                <tbody id="ClientCategoryWise_Data">
                            </tbody>
                        </table>
