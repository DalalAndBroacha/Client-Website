@model ViewModel.Reports.XIRR;

@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "XIRR summary";
}

@{ string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {
    
    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
}


<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">

        <div id="waitIn" class="a11y-loading-indicator" style="display:none;width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>

        <div style="position:unset; background-color:white; padding:0.5rem;">

            <div id="divViewRepo">
                <div class="d-flex justify-content-center">
                    <div class="col-4">
                        <label>Account Code</label>

                        @if (@ViewBag.Acc == "0")
                        {
                            <label for="txtAccCode" class="a11y-visually-hidden">Account code</label>
                            <input type="text" id="txtAccCode" />
                        }
                        else
                        {
                            @* 3.3.2 Labels or Instructions — the read-only account
                               code display had no accessible name at all. *@
                            <label for="txtAccCodeDisplay" class="a11y-visually-hidden">Account code</label>
                            <input type="text" id="txtAccCodeDisplay" readonly value="@ViewBag.Acc" />
                        }

                    </div>
                    <div class="col-2">
                        <button onclick="myFunctionLoadData()" class="btn btn-sm DnB-RedLabel">View Report</button>
                    </div>
                </div>
            </div>


            
            @*<div id="XIRR_Level_2">*@
            <div id="XIRR_Summary" style="display:none;">

                @{

                    ViewBag.ReportName = "Equity APR";
                    ViewBag.ReportHeaderDiv = "EqAPR";
                    ViewBag.GenDate = "True";

                    ViewBag.PrimaryReport = "True";

                    ViewBag.ElementPDFBtnID = "btnExportPdfXIRRPageClientWise";
                    ViewBag.ElementExcelBtnID = "btnExportXIRRPageClientWise";
                    ViewBag.ElementEmailBtnID = "btnEMailXIRRPageClientWise";

                    ViewBag.ElementBackBtnID = "btnXIRRback";

                    Html.RenderPartial("_ReportHeaderCompact");
                }
                <input type="text" id="client_acc_code" hidden>
                <input type="text" id="client_name" hidden>
                <input type="text" id="family_name" hidden>
                <div class="card" style="padding: 5px; position: unset;">
                    <div class="row">
                        <div class="col-md-12">
                            <table class='table table-bordered' id="myTableclientflow">
                                <tr class="header" style="border: 1px solid #dddddd;">
