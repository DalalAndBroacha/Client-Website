                                <input type="text" id="txtXirrDiviFY" hidden>
                                <input type="text" id="txtXirrDiviCliCode" hidden>

                            <div class="d-flex justify-content-center SubTotalRow">
                                <p id="paraXirrDivi" style="text-align:center">Dividend of <span id="XirrDiviCliName"></span> for the FY - <span id="XirrDiviFY"></span></p>
                            </div>

                            <table class='table table-redbordered' id="XirrDivi" style="border-collapse: collapse;">
                                <thead class="stickyThead">
                                    <tr class="header" style="border: 1px solid #dddddd;">
                                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Date</b></p></th>
                                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Scrip Name</b></p></th>
                                        <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Amount</b></p></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyXirrDivi">
                                </tbody>
                            </table>

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                        </div> <!-- end modal footer -->
                    </div> <!-- end modal content-->
                </div>
            </div>
            <!-- Dividend Modal -->

            <!-- Gain Loss Modal -->
