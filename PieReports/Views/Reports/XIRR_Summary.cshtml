                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading1"><b>Client (Code)</b></p></th>
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading1"><b>Acc Opening Date</b></p></th>
                                </tr>
                                <tbody id="tbodyBindingclientflow">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <table class='table' id="myTableclientflow1" style="border-collapse: collapse;">

                                <tr class="header" style="border: 1px solid #dddddd;">
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading1"><b>Portfolio Activity</b></p></th>
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading2"><b>Amount</b></p></th>

                                </tr>
                                <tbody id="tbodyBindingclientflow1">
                                </tbody>
                            </table>
                        </div>

                        <div class="col-sm-6">
                            <table class='table' id="myTableclientflow2" style="border-collapse: collapse;">

                                <tr class="header" style="border: 1px solid #dddddd;">
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading1"><b>Sector</b></p></th>
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading2"><b>Amount</b></p></th>
                                    <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading2"><b>Holding %</b></p></th>

                                </tr>
                                <tbody id="tbodyBindingclientflow2">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div id="div_XIRR_PnL">
                        <table class='table' id="XIRR_PnL_table" style="border-collapse: collapse;">
                            <tr style="border: 1px solid #dddddd;">
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd; text-align:center; vertical-align:middle;" rowspan="2" scope="col"><p><b>F.Y.</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="4" scope="col"><p class="tableheading"><b>Profit/</b><b style="color: #b3241a;">(Loss)</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="1" scope="col"> </th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" colspan="4" scope="col"><p class="tableheading"><b>Performance (%)</b></p></th>
                            </tr>
                            <tr class="header" style="border: 1px solid #dddddd;">
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Intraday</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Short Term</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Long Term</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Total</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Dividend</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>ABS</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>XIRR</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>NIFTY</b></p></th>
                                <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>MIDCAP</b></p></th>
                            </tr>
                            <tbody id="tbodyBindingXIRRPnL">
                            </tbody>
                        </table>
                        <div id="referlink"></div>
                    </div>
                </div>
            </div>

            <!-- Dividend Modal -->
            <div class="modal fade" id="XIRR_dividend" data-backdrop="static" tabindex="-1" aria-hidden="true" role="dialog" aria-modal="true" aria-label="XIRR dividend">
                <div class="modal-dialog">
                    <div class="modal-content" style="width:80%; height:80vh; margin: auto">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div> <!-- end modal header -->
                        <div class="modal-body">
                            @{
                                ViewBag.ReportName = "";
                                ViewBag.ReportHeaderDiv = "XirrDivi";
                                ViewBag.GenDate = "False";

                                ViewBag.PrimaryReport = "True";

                                ViewBag.ElementPDFBtnID = "btnExportPdfXirrDivi";
                                ViewBag.ElementExcelBtnID = "btnExportXirrDivi";
                                ViewBag.ElementEmailBtnID = "btnEMailXirrDivi";

                            }
