                                </div> *@
                                <table class='table table-redbordered' id="XirrPNL" style="border-collapse: collapse;">
                                    <thead class="stickyThead">
                                        <tr class="header">
                                            <th scope="col"><p class="tableheading"></th>
                                            <th colspan="3" scope="col"><p class="tableheading"><b>Buy</b></p></th>
                                            <th colspan="3" scope="col"><p class="tableheading"><b>Sell</b></p></th>
                                            <th colspan="4" scope="col"><p class="tableheading"><b>Gain / Loss</b></p></th>
                                        </tr>
                                        <tr class="header">
                                            <th scope="col"><p class="tableheading">Qty</th>
                                            <th scope="col"><p class="tableheading">Date</th>
                                            <th scope="col"><p class="tableheading">Rate</th>
                                            <th scope="col"><p class="tableheading">Amount</th>
