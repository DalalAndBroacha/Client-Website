@model ViewModel.Reports.RPT
@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Common documents";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}


<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @{

            ViewBag.ReportName = "Common Documents";
            ViewBag.ReportHeaderDiv = "ComDocs";
            ViewBag.GenDate = "False";

            Html.RenderPartial("_ReportHeader");

            ViewBag.PrimaryReport = "True";

            ViewBag.ElementPDFBtnID = "btnExportPdfCommonDocs";
            ViewBag.ElementExcelBtnID = "btnExportCommonDocs";
            ViewBag.ElementPrintBtnID = "btnPrintCommonDocs";
            ViewBag.ElementEmailBtnID = "btnEMailCommonDocs";
            ViewBag.ElementPrintBtnOnClickEvent = "print('#CommonDocs')";

            ViewBag.ElementBackBtnID = null;

            Html.RenderPartial("_NonPerfReportButtonsDiv");
        }
        <!-- Main content -->
        <section class="content">
            <div class="row">
                @foreach (var rpt in Model.commdocrpt.GroupBy(x => x.report_category))
                {
                    <div class="col-md-6 card-panel-grid">
                        <div class="card card-primary">

                            @* 4.1.1 Parsing — id="header" was inside this @@foreach, producing one
                               duplicate per category. Nothing referenced it. *@
                            <div class="card-header" style="background-color: #ffb3b3;">
                                <h2 class="card-title h3">@rpt.Key</h2>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-card-widget="collapse"
                                            title="Collapse" aria-expanded="true"
                                            aria-label="Collapse the @rpt.Key documents">
                                        <i class="fas fa-minus" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">

                                @foreach (var item in rpt.GroupBy(y => y.report_subcategory))
                                {


                                    <div class="card-header" style="background-color: #ffe6e6;border:1px solid #ffb3b3;">
                                        <h3 class="card-title">@item.Key</h3>
                                    </div>
                                    <br />
                                    @foreach (var items in item)
                                    {
                                        <div class="form-group">
                                            @* 1.3.1 Info and Relationships — this was a <label>
                                               with a `for` that matched no control, repeated once
                                               per document, so screen readers announced a form
                                               field that does not exist and the ids collided.
                                               2.1.1 / 4.1.2 — opening a document in a dialog is a
                                               button action, not a link to "#". *@
                                            <p style="font-weight: 500; margin-bottom: 0px; margin-left: 6px;">
                                                <button type="button" class="btn btn-link p-0" style="font-family: inherit; font-size: 15px;"
                                                        onclick="ReportIFrame('@items.report_link','@items.report_caption');">
                                                    @items.report_caption
                                                </button>
                                            </p>
                                        </div>
                                    }

                                }
                            </div>
                        </div>
                    </div>

                }
            </div>

        </section>
        <!-- /.content -->
    </div>
</div>


<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="myModal-title">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="min-width:90%;">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h6 class="modal-title" style="padding:10px;" id="myModal-title"></h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close dialog"><span aria-hidden="true">&times;</span></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body" style="padding: 0rem !important;">
                @* 4.1.2 Name, Role, Value — a frame with no title is announced only
                           by its URL, so the user cannot tell what is inside before
                           entering it. *@
                        <iframe src="" title="Document viewer" style="width: 100% !important;height:400px" frameborder="0" allowtransparency="true"></iframe>
            </div>

            <!--  Modal footer -->
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () { 
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        //gtag('config', 'G-6FJ1RE3WC0'); 
        gtag('config', 'G-6FJ1RE3WC0', {
            'page_title': 'CommonDocument',
            'page_path': '/Reports/CommonDocument'
        });
        gtag('event', 'CommonDocument', {
            'event_category': 'CommonDocument',
            'event_label': 'CommonDocument'
        });
    });
    function CommonUpdateFev() {
        var formdata = {
            "module_id": $("p[name='Common Documents']").attr("id")
        }
        var posturl = "/ClientPortal/Pie/UpdateFev";
        $.ajax({
            url: posturl,
            type: "post",
            contentType: "application/json",
            data: JSON.stringify(formdata),
            success: function (data) {
                //  alert(data)
                if (data.sql_status == "Fail") {
                    alert(data.sql_message);
                } else {
                    FetchFev();
                    setTimeout(function () {
                        $(".fetchId").each(function () {
                            if ($(this).attr('id') == $("p[name='Common Documents']").attr("id")) {
                                $("#liAddtoFavourite").hide();
                                $("#liRemoveFavourite").show();
                                return false;
                            } else {
                                $("#liAddtoFavourite").show();
                                $("#liRemoveFavourite").hide();
                            }
                        })
                    }, 500);
                }
            },
            error: function (xhr, err) {
                alert(err)
            }
        })
    }
