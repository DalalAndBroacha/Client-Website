@using ViewModel.Login
@using Newtonsoft.Json
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Dividend dashboard";
}

@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

<div class="wrapper">
    <div class="content-wrapper" id="main-content" role="main" tabindex="-1">
        @* 1.3.1 / 2.4.6 — the design shows no page name, so the page
           heading is provided for assistive technology only and is kept
           in step with the <title> set at the top of this view. *@
        <h1 class="a11y-visually-hidden">@ViewData["Title"]</h1>
        @*Loader*@
        <div id="DiviwaitIn" class="a11y-loading-indicator" style="display:none;width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="" />
        </div>
        @*Loader*@

        <div id="main_Div" class="card" style="position: unset; background-color: white; max-height:500px; margin-top:70px;">
            <h2>Dividend</h2>
            <div id="PIE_Chart" style="height:300px; width:70%; margin-left:auto;"></div>
        </div>
    </div>
</div>

<script src="~/Apex/ApexChatsCDN.js"></script>
<script src="~/Jquery/DividendDashboard.js"></script>