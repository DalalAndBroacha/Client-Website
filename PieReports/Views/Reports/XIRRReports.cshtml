                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Total</b></p></th>
                                            @*<th scope="col">Cash(%)</th>*@

                                            @*<th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p><b>Value</b></p></th>
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p><b>%</b></p></th>*@
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>XIRR</b></p></th>
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Nifty XIRR</b></p></th>
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>ABS</b></p></th>
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>XIRR</b></p></th>
                                            <th style="background-color: #ffb3b3; border: 1px solid #dddddd;" scope="col"><p class="tableheading"><b>Nifty XIRR</b></p></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyBinding">
                                    </tbody>
                                </table>
                            </div>
                            <div id="noReFound"></div>
