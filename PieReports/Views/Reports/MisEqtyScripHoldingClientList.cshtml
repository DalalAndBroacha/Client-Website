@using ViewModel.Login
@using Newtonsoft.Json
@model ViewModel.Shared.DisplayEqScripHolCliList
@{
    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}

@section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
    <link href="~/css/datatableselect.min.css" rel="stylesheet" />

    <link href="~/css/reports/equityanalytics.css" rel="stylesheet" asp-append-version="true" />
}

<div class="wrapper">
    <div class="content-wrapper">
        @{

            ViewBag.ReportName = "Scrip Holding Client List";
            ViewBag.ReportHeaderDiv = "EqScripHolClientList";
            ViewBag.GenDate = "False";

            <partial name="_ReportHeader" />
        }
        <div id="GlobalwaitIn" style="display:none; width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
            <img src="~/images/loader.gif" width="64" height="64" alt="Loading..." />
        </div>

        <div id="main_div" style="position:unset; background-color:white !important; padding:1rem;">

            @if (Model.scrip_code != null && Model.rm_id != null)
            {
                <input id="txtHidScripCode" type="text" value="@Model.scrip_code" readonly hidden />
                <input id="txtHidRmId" type="text" value="@Model.rm_id" readonly hidden />
            }
            else
            {
                <input id="txtHidScripCode" type="text" value="0" readonly hidden />
                <input id="txtHidRmId" type="text" value="0" readonly hidden />
            }


            <div class="row justify-content-start">
                <div class="input-group mb-0 col-md-5">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel mb-2" for="ddlBHRMList">
                            Select Branch or RM
                        </label>
                        <select class="form-control select2" id="ddlBHRMList" style="border-right: 1px solid black;
                            border-top: 1px solid black; border-bottom: 1px solid black;">

                            @if (Model.BH_RM_list != null)
                            {
                                @foreach (var key in Model.BH_RM_list)
                                {
                                    <option value="@key.login_id">@key.display_name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
                <div class="input-group mb-0 col-md-3">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel mb-2" for="ddlDataList">
                            Data Type
                        </label>
                        <select class="form-control select2" id="ddlDataList">
                            <option value="1">All</option>
                            <option value="2">Holding</option>
                            <option value="3">No Holding</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <button type="button" onclick="ViewData()" class="btn DnB-RedLabel ml-2">View Report</button>
                </div>
            </div>

            <div class="row mt-1">
                <div class="input-group col-md-10">
                    <div class="input-group-prepend">
                        <label class="input-group-text DnB-RedLabel" for="ddlScripList">
                            Select Scrip
                        </label>
                        <select class="form-control select2" id="ddlScripList" multiple>
                            @if (Model.script_list != null)
                            {
                                @foreach (var key in Model.script_list)
                                {
                                    <option value="@key.scrip_code">@key.SCRIP_NAME</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
            </div>

            <div id="divDataTable" style="display:none; padding:0.5rem; max-height:80vh;">
                <hr class="redHR mt-2 mb-2" />
                <div style="padding:0.5rem; overflow-y:scroll; overflow-x:auto; max-height:55vh;">
                    <div class="SubTotalRow row mb-2" id="_EqMISReportHeaderCompact">
                        <div class="offset-2"></div>
                        <div class="col-8 d-flex justify-content-center">
                        </div>
                        <div class="col-2">
                            <div class="d-flex justify-content-end mt-1 mb-1">

                                <button title="Export to Excel" id="btnExcel" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                                    <i class="far fa-file-excel" style="color: white; padding:0; width:30px;"></i>
                                </button>
                               
                                <button title="Email" id="btnEmail" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                                    <i class="fas fa-envelope" style="color: white; padding:0; width:30px;"></i>
                                </button>
                                 
                            </div>
                        </div>
                    </div>
                    <table id="tblData" class="table table-bordered w-100">
                        <thead>
                            <tr>
                                <th>Family</th>
                                <th>Client</th>
                                <th>Account Code</th>
                                <th>RM</th>
                                <th>Scrip Name</th>
                                <th>Holding Quantity</th>
                                <th>Purchase Cost</th>
                                <th>Purchase Value</th>
                                <th>Holding Value</th>
                                <th>Portfolio Value</th>
                                <th>Holding Percentage</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>
<script src="~/hyper/js/vendor/datatables.select.min.js"></script>
<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>
<script src="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.js"></script>

<script src="~/Jquery/Reports/MisEqtyScripHoldingClientList.js" asp-append-version="true"></script>
