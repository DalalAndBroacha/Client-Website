@using ViewModel.Login
@using Newtonsoft.Json
@model UserLogin;
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Capital gain report";
}


@* @section Styles {

    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
    <link href="~/css/Reports/GlobalReport.css" rel="stylesheet" asp-append-version="true" />
} *@


@{
    @* `Layout = null` used to be viable here only because
       ~/Pages/_Layout.cshtml emitted a whole second HTML document. Now that it
       is a fragment, suppressing the layout leaves this page with no <html
       lang>, no <title>, no skip link and none of the accessibility layer —
       failing 3.1.1, 2.4.2 and 2.4.1 outright. It uses the shared layout like
       every other page. *@

    string dtoq = TempData["myDeshbordData"].ToString();
    TempData.Keep("myDeshbordData");
    Dashboard dashboard = JsonConvert.DeserializeObject<Dashboard>(dtoq);
    Html.RenderPartial("~/Pages/_Layout.cshtml", dashboard);
}


<div class="content-wrapper" id="main-content" role="main" tabindex="-1" style="margin-top:35px;">

    <div id="GlobalwaitIn" class="a11y-loading-indicator" style="display:none; width:69px;height:69px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;">
        <img src="~/images/loader.gif" width="64" height="64" alt="" />
    </div>

    <div style="position:unset; background-color:white; padding:0.5rem;">   
        <div class="row justify-content-center" id="paramsTray">
            <div class="col-3">
                <label for="ddlClientList">Client</label>
                <select style="border: 1px solid #cccccc; height:38px;" class="form-control mb-1" id="ddlClientList">
                </select>
            </div>
            <div class="col-2 mt-2 row" id="date_pills">

                <div class="d-flex align-items-start flex-column col-md-4">

                    <button id="pill_Q1" style="width:60px;" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Upto Q1</button>
                    <button id="pill_Q2" style="width:60px;" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Upto Q2</button>
                    <button id="pill_Q3" style="width:60px;" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Upto Q3</button>

                    <input type="text" id="txt_Q1" hidden readonly />
                    <input type="text" id="txt_Q2" hidden readonly />
                    <input type="text" id="txt_Q3" hidden readonly />

                </div>
                <div class="ml-2 d-flex align-items-start flex-column col-md-5">

                    <button id="pill_curr_fy" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Current FY</button>
                    <button id="pill_prev_fy" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Previous FY</button>
                    <button id="pill_cst_date" class="badge badge-pill badge-danger mb-1" onclick="setPickerDates(this.id)">Custom Dates</button>

                    <input type="text" id="txt_prev_fy_start_date" hidden readonly />
                    <input type="text" id="txt_prev_fy_end_date" hidden readonly />
                    <input type="text" id="txt_curr_fy_start_date" hidden readonly />
                    <input type="text" id="txt_curr_fy_end_date" hidden readonly />

                </div>

            </div>
            <div class="col-2">
                <label for="inpStartDate">Start Date</label>
                <input class="form-control" type="date" id="inpStartDate" disabled>
            </div>
            <div class="col-2">
                <label for="inpEndDate">End Date</label>
                <input class="form-control" type="date" id="inpEndDate" disabled>
            </div>
            <div class="col-2 mt-4">
                <button onclick="ViewCapitalGainReport()" class="btn btn-sm DnB-RedLabel">View Report</button>
            </div>
        </div>

        <div id="main_div" style="display:none;" class="mt-1">

            <div class="SubTotalRow row justify-content-between">
                <div class="offset-3"></div>
                <div class="text-center col-4">
                    <b id="lblReport_Name" role="heading" aria-level="1">Capital Gain Report of </b><b id="clientName"></b><b id="timePeriod"></b><br>
                    <span style="font-size:9px;">Generated On: <b>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")</b></span>
                </div>
                <div class="row col-3" id="_EqMISReportHeaderCompact">
                    
                    <div class="row col-12 justify-content-end mt-2 mb-1" style="max-height:30px;">

                        <button title="Toggle Report Parameters" id="btnParams" aria-label="Toggle report parameters" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                            <i class="fas fa-sliders-h" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                        </button>

                        <button title="Export to PDF" id="btnPdf" aria-label="Export to PDF" type="button" class="a11y-report-btn" style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333;">
                            <i class="far fa-file-pdf" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                        </button>

                        <div class="dropleft" title="Export to Excel">
                            <button type="button" data-toggle="dropdown" id="dropdownBtnXls"
                                    class="a11y-report-btn" aria-haspopup="true" aria-expanded="false"
                                    aria-label="Export to Excel"
                                    style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333; height:30px;">
                                <i class="far fa-file-excel" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                            </button>
                            <div class="dropdown-menu dropDownExcelOpts" aria-labelledby="dropdownBtnXls">
                                <a class="dropdown-item" id="ExcelNormalFormat" href="#" role="button">Normal Format</a>
                                <a class="dropdown-item" id="ExcelItrFormat" href="#" role="button">ITR Format</a>
                            </div>
                        </div>

                        <div class="dropleft" title="Email">
                            <button type="button" data-toggle="dropdown" id="dropdownBtnEmail"
                                    class="a11y-report-btn" aria-haspopup="true" aria-expanded="false"
                                    aria-label="Email"
                                    style="border: 2px solid #FCE0E0; padding: 0; background-color: #ff3333; height:30px;">
                                <i class="fas fa-envelope" aria-hidden="true" style="color: white; padding:0; width:30px;"></i>
                            </button>
                            <div class="dropdown-menu dropDownEmailOpts" aria-labelledby="dropdownBtnEmail">
                                <a class="dropdown-item" href="#" id="EmailNorForPdf" role="button">Email Normal Format(PDF)</a>
                                <a class="dropdown-item" href="#" id="EmailNorForXls" role="button">Email Normal Format(Excel)</a>
                                <a class="dropdown-item" href="#" id="EmailItrForXls" role="button">Email ITR Format(Excel)</a>
                                @* @if (Model.Role_Name != "Family Head")
                                {
                                    <a class="dropdown-item" href="#" id="EmailNorForPdfCli" role="button">Email to client Normal Format(PDF)</a>
                                    <a class="dropdown-item" href="#" id="EmailNorForXlsCli" role="button">Email to client Normal Format(Excel)</a>
                                    <a class="dropdown-item" href="#" id="EmailItrForXlsCli" role="button">Email to client ITR Format(Excel)</a>
                                } *@
                            </div>
                        </div>

                    </div>
                    
                </div>
            </div>
            

            <div id="divDataTblComponent">
                <div id="div_PnL">
                    <table id="mainTable_PnL" class="table mt-2 table-hover w-100 table-redbordered">
                    </table>
                </div>
            </div>

            <!-- Modal Report Format -->
            <div class="modal fade" id="historyModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="HistoryModalTitle">
                <div class="modal-dialog modal-dialog-centered" role="document" style="width:45%; height:20%;">
                    <div class="modal-content p-1">
                        <div class="modal-header">
                            <h5 class="modal-title ml-auto" id="HistoryModalTitle">Report Format</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <!-- Modal Report Format Body Start -->
                        <div class="p-1" style="min-height:20%; min-width:40%;">

                            <div class="row justify-content-center">
                                <div class="input-group mb-0 col-md-4 mb-2">
                                    <div class="input-group-prepend">
                                        <label class="input-group-text DnB-RedLabel mb-0" for="ddlBHRMList">
                                            Action
                                        </label>
                                        <select class="form-control select2 mb-0" id="ddlBHRMList" style="border-right: 1px solid black;
                                        border-top: 1px solid black; border-bottom: 1px solid black;">

                                            <option value="E">Email</option>
                                            <option value="E">Export</option>

                                        </select>
                                    </div>
                                </div>
                                <div class="input-group mb-0 col-md-4">
                                    <div class="input-group-prepend">
                                        @* 1.3.1 Info and Relationships — this label pointed at
                                           the "Action" select above, because both selects shared
                                           the id ddlBHRMList. The second select is now
                                           ddlBHRMList_2 so the label binds to the right control. *@
                                        <label class="input-group-text DnB-RedLabel mb-2" for="ddlBHRMList_2">
                                            File Type
                                        </label>
                                        <select class="form-control select2" id="ddlBHRMList_2" style="border-right: 1px solid black;
                                        border-top: 1px solid black; border-bottom: 1px solid black;">

                                            <option value="E">Excel</option>
                                            <option value="E">Pdf</option>

                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- Modal Report Format Body End -->
                        <div class="modal-footer p-1">
                            <button type="button" class="btn btn-success" data-dismiss="modal" onclick="DownloadReport('xls')">Download Report</button>
                            <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Modal Report Format-->

        </div>
    </div>

    
</div>

<link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
<link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
<link href="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.css" rel="stylesheet" />
<link href="~/css/Reports/GlobalReport.css" rel="stylesheet" asp-append-version="true" />

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>
<script src="~/Apex/CheckBoxToggle-bootstrap4-toggle.min.js"></script>

<script src="~/Jquery/Reports/CapitalGain.js" asp-append-version="true"></script>
