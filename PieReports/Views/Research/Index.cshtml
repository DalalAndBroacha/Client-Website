@using Microsoft.Extensions.Configuration
@* @using System.Globalization; *@
@inject IConfiguration Configuration
@model List<ViewModel.Shared.psp_dsp_equity_research_reports>

@section Styles {
    <link href="~/css/dnb.css" rel="stylesheet" asp-append-version="true" />
	<link asp-append-version="true" href="~/css/ReserachLanding.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="https://s3.amazonaws.com/assets.freshdesk.com/widget/freshwidget.css" rel="stylesheet" type="text/css" />
    
}

<div class="theme-loader">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* <body style="background-image:url('/ClientPortal/images/trialBack.jpg'); background-repeat: no-repeat; background-attachment: fixed; background-size:;"> *@
<body style="font-family:Roboto, sans-serif;">
    <div id="Header_Logo">
        <div class="d-flex justify-content-center">
            <img class="img-fluid" src="~/images/logo.svg" style="height:57px; margin-top:15px;" />
        </div>
    </div>

    <hr class="redHR"/>

    <div class="container-fluid p-4 mt-1">
        <h2 style="color:#ee3426">EQUITY RESEARCH REPORTS</h2>
        <div style="padding:0.5rem; overflow-y:scroll; overflow-x:auto; max-height:60vh;">
            <table id="tblReportsData" class="table table-bordered ml-1 mr-1 pr-2">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Title</th>
                        <th>Sector</th>
                        <th>Recommendation</th>
                        <th>Recommendation Price</th>
                        <th>CMP</th>
                        <th>Target</th>
                        <th>Report</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in Model)
                    {
                        <tr>
                            <td data-sort='@key.Latest_reco_date.ToString("yyyyMMdd")'><p>@key.Latest_reco_date.ToString("dd-MM-yyyy")</p></td>
                            <td><p>@key.Category</p></td>
                            <td><p>@key.Report_Title</p></td>
                            <td>@key.Sector</td>
                            <td class="paraTextAlignCenter"><p>@key.Recommendation</p></td>
                            <td class="paraTextAlignRight">@key.Reco_price</td>
                            <td class="paraTextAlignRight">@key.CMP</td>
                            <td class="paraTextAlignRight">@key.Price_target</td>
                            <td class="paraTextAlignCenter"><p><a href="@key.URL" target="_blank">View</a></p></td>
                        </tr>
                    }
                    <tr>
                        <td data-sort="20230331"><p>31-03-2023</p></td>
                        <td><p>Other</p></td>
                        <td><p>Historical Reports</p></td>
                        <td>Other</td>
                        <td class="paraTextAlignCenter"><p>-</p></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignCenter"><p><a href="https://www.dalal-broacha.com/Old_Research_Reports.html" target="_blank">View</a></p></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row justify-content-center">
        <p id="OldReportsPage" class="lead" style="background-color:#ffd2c1;">
        </p>
    </div>
    <partial name="_IndexFooter">
</body>

<script src="~/js/bootstrap/js/bootstrap.min.js"></script>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>

<script src="~/jquery/DnB.js" asp-append-version="true"></script>
<script src="~/jquery/Dashboard.js" asp-append-version="true"></script>
<script src="~/jquery/research/landingpage.js" asp-append-version="true"></script>