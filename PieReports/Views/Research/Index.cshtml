@using Microsoft.Extensions.Configuration
@{
    // WCAG 2.4.2 Page Titled — unique and descriptive, most specific
    // information first. Rendered by Views/Shared/_Layout.cshtml.
    ViewData["Title"] = "Research";
}

@* @using System.Globalization; *@
@inject IConfiguration Configuration
@model List<ViewModel.Shared.psp_dsp_equity_research_reports>

@section Styles {
    <link href="~/css/dnb.css" rel="stylesheet" asp-append-version="true" />
	<link asp-append-version="true" href="~/css/ReserachLanding.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/Hyper/css/vendor/responsive.bootstrap4.css" rel="stylesheet" />
    <link href="https://s3.amazonaws.com/assets.freshdesk.com/widget/freshwidget.css" rel="stylesheet" type="text/css" />
    
}

@* 1.1.1 — decorative pre-loader, hidden from assistive technology. *@
<div class="theme-loader" aria-hidden="true">
    <div class="loader-track">
        <div class="preloader-wrapper">
            <div class="spinner-layer spinner-blue">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
            <div class="spinner-layer spinner-red">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-yellow">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>

            <div class="spinner-layer spinner-green">
                <div class="circle-clipper left">
                    <div class="circle"></div>
                </div>
                <div class="gap-patch">
                    <div class="circle"></div>
                </div>
                <div class="circle-clipper right">
                    <div class="circle"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* <body style="background-image:url('/ClientPortal/images/trialBack.jpg'); background-repeat: no-repeat; background-attachment: fixed; background-size:;"> *@
@* 4.1.1 Parsing — this view opened a second <body> inside the layout's
   body. Replaced with the landmarks the page actually needs. *@
<div style="font-family:Roboto, sans-serif;">
    <header id="Header_Logo">
        <div class="d-flex justify-content-center">
            <img class="img-fluid" src="~/images/logo.svg" style="height:57px; margin-top:15px;" alt="Dalal &amp; Broacha Stock Broking Pvt. Ltd." />
        </div>
    </header>

    <hr class="redHR" />

    <main id="main-content" tabindex="-1" class="container-fluid p-4 mt-1">
        @* 2.4.6 Headings and Labels — the page name is the h1, sized as the
           h2 it was. 1.4.3 — #ee3426 is 4.07:1 on white, which passes for
           text this large (2rem, needs 3:1), so the design colour stays. *@
        <h1 class="h2" style="color:#ee3426">EQUITY RESEARCH REPORTS</h1>
        @* 1.4.10 Reflow — a scrolling data table is exempt from the
           no-horizontal-scroll rule, but the scroll container has to be
           reachable and operable by keyboard (2.1.1). *@
        <div class="a11y-table-scroll" role="region" tabindex="0"
             aria-label="Equity research reports, scrollable table"
             style="padding:0.5rem; overflow-y:scroll; overflow-x:auto; max-height:60vh;">
            <table id="tblReportsData" class="table table-bordered ml-1 mr-1 pr-2">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Category</th>
                        <th scope="col">Title</th>
                        <th scope="col">Sector</th>
                        <th scope="col">Recommendation</th>
                        <th scope="col">Recommendation Price</th>
                        <th scope="col">CMP</th>
                        <th scope="col">Target</th>
                        <th scope="col">Report</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in Model)
                    {
                        <tr>
                            <td data-sort='@key.Latest_reco_date.ToString("yyyyMMdd")'><p>@key.Latest_reco_date.ToString("dd-MM-yyyy")</p></td>
                            <td><p>@key.Category</p></td>
                            <td><p>@key.Report_Title</p></td>
                            <td>@key.Sector</td>
                            <td class="paraTextAlignCenter"><p>@key.Recommendation</p></td>
                            <td class="paraTextAlignRight">@key.Reco_price</td>
                            <td class="paraTextAlignRight">@key.CMP</td>
                            <td class="paraTextAlignRight">@key.Price_target</td>
                            <td class="paraTextAlignCenter"><p><a href="@key.URL" target="_blank" rel="noopener noreferrer">View<span class="a11y-visually-hidden"> the report: @key.Report_Title (opens in a new tab)</span></a></p></td>
                        </tr>
                    }
                    <tr>
                        <td data-sort="20230331"><p>31-03-2023</p></td>
                        <td><p>Other</p></td>
                        <td><p>Historical Reports</p></td>
                        <td>Other</td>
                        <td class="paraTextAlignCenter"><p>-</p></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignRight"></td>
                        <td class="paraTextAlignCenter"><p><a href="https://www.dalal-broacha.com/Old_Research_Reports.html" target="_blank" rel="noopener noreferrer">View<span class="a11y-visually-hidden"> the historical reports archive (opens in a new tab)</span></a></p></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    </main>
    <div class="row justify-content-center">
        @* 4.1.3 Status Messages — the script writes the paging summary here. *@
        <p id="OldReportsPage" class="lead" role="status" aria-live="polite" style="background-color:#ffd2c1;">
        </p>
    </div>
    <footer>
        <partial name="_IndexFooter" />
    </footer>
</div>

<script src="~/js/bootstrap/js/bootstrap.min.js"></script>

<!-- Datatables js -->
<script src="~/Hyper/js/vendor/jquery.dataTables.min.js"></script>
<script src="~/Hyper/js/vendor/dataTables.bootstrap4.js"></script>
<script src="~/Hyper/js/vendor/dataTables.responsive.min.js"></script>
<script src="~/Hyper/js/vendor/responsive.bootstrap4.min.js"></script>

<!-- Datatable Init js -->
<script src="~/Hyper/js/demo/demo.datatable-init.js"></script>

<script src="~/jquery/DnB.js" asp-append-version="true"></script>
<script src="~/jquery/Dashboard.js" asp-append-version="true"></script>
<script src="~/jquery/research/landingpage.js" asp-append-version="true"></script>